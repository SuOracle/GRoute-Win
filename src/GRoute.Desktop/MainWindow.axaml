<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GRoute.Desktop.Controls"
        xmlns:core="using:GRoute.Windows.Core"
        xmlns:vm="using:GRoute.Desktop"
        x:Class="GRoute.Desktop.MainWindow"
        Width="560" Height="748" CanResize="False"
        Title="GRoute"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None">

    <Window.Resources>
        <c:PingBrushConverter x:Key="PingBrush"/>
        <c:PingLabelConverter x:Key="PingLabel"/>
        <c:FlagConverter x:Key="Flag"/>
        <c:FlagNameConverter x:Key="FlagName"/>
        <c:FlagPresentConverter x:Key="FlagPresent"/>
        <c:CheckBorderConverter x:Key="CheckBorder"/>
        <c:PingBoxVisConverter x:Key="PingBoxVis"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#F2101C3C"/>
            <Setter Property="BorderBrush" Value="#3D6AD6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="RenderTransformOrigin" Value="50%,0%"/>
            <Style.Animations>
                <Animation Duration="0:0:0.17" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="-12"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Panel Background="{x:Null}">
        <Panel Name="ZoomHost" Opacity="0">

        <Border Name="AppGlow" Width="484" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,24,0,0" CornerRadius="12" IsHitTestVisible="False"
                Background="#0E1A38"
                Height="{Binding #AppSurface.Bounds.Height}">
            <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="20" Color="#040D1F" Opacity="1"/>
            </Border.Effect>
        </Border>

        <Border Name="AppSurface" Focusable="True" Width="484" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,24,0,0" CornerRadius="12" ClipToBounds="True"
                Background="#0E1A38"
                Cursor="{x:Static c:AppCursors.Arrow}">
            <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#22396B" Offset="0"/>
                <GradientStop Color="#13234A" Offset="0.5"/>
                <GradientStop Color="#0A1631" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <c:ParticleField Name="Particles" Opacity="0.5" IsVisible="False"/>
        <c:StarField Name="Stars" Opacity="0.85" IsVisible="False"/>
        <c:VeinField Name="Veins" Opacity="0.9" IsVisible="False"/>

        <Panel Name="BlurLayer" IsHitTestVisible="False">
            <Panel>
                <Panel.Effect>
                    <BlurEffect Radius="24"/>
                </Panel.Effect>
                <Panel.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#22396B" Offset="0"/>
                        <GradientStop Color="#13234A" Offset="0.5"/>
                        <GradientStop Color="#0A1631" Offset="1"/>
                    </LinearGradientBrush>
                </Panel.Background>
                <c:ParticleField Name="ParticlesBlur" Opacity="0.72" IsVisible="False"/>
                <c:StarField Name="StarsBlur" Opacity="0.6" IsVisible="False"/>
                <c:VeinField Name="VeinsBlur" Opacity="0.7" IsVisible="False"/>
            </Panel>
        </Panel>

        <Grid RowDefinitions="42,Auto,*">

            <Border Grid.Row="0" Name="TitleBar" Background="#0E1A38" CornerRadius="10,10,0,0"
                    PointerPressed="TitleBar_Pressed">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="14,0,0,0" Padding="0,0,2,0" UseLayoutRounding="False">
                        <Image Name="TitleLogo" Stretch="Uniform" StretchDirection="Both"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Classes="titlebtn" Click="Minimize_Click" Margin="0,0,2,0">
                            <Path Data="M 0,0 H 11" Stroke="#C9D6EE" StrokeThickness="1.4" StrokeLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="titlebtn close" Click="Close_Click">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#C9D6EE" StrokeThickness="1.4"
                                  StrokeLineCap="Round" Width="11" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Name="HeaderRow" Margin="16,8,16,12" ColumnDefinitions="Auto,Auto,*">
                <Button Grid.Column="0" Name="MenuButton" Click="ToggleMenu_Click" Width="30" Height="30"
                        Classes="live flat" Padding="0" Margin="2,0,0,0" VerticalAlignment="Center"
                        PointerEntered="MenuBtn_Entered" PointerExited="MenuBtn_Exited"
                        Background="#001A2743" BorderBrush="#9FB3D6" BorderThickness="2" CornerRadius="7">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ Border#Bd">
                            <Setter Property="Background" Value="#001A2743"/>
                        </Style>
                        <Style Selector="Button.hovered /template/ Border#Bd">
                            <Setter Property="Background" Value="{StaticResource HoverTint}"/>
                        </Style>
                    </Button.Styles>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel Width="16" Height="6" Margin="0,0,0,2">
                            <Rectangle Width="16" Height="2" Fill="#E3EBFA" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center"/>
                            <Panel Name="MenuKnob1" Width="11" Height="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderTransform="translateX(-4.5px)">
                                    <Ellipse Width="11" Height="11">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#B3FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="5" Height="5" Fill="#6E9CF0" Stroke="White" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                        </Panel>
                        <Panel Width="16" Height="6" Margin="0,0,0,2">
                            <Rectangle Width="16" Height="2" Fill="#E3EBFA" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center"/>
                            <Panel Name="MenuKnob2" Width="11" Height="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderTransform="translateX(4.5px)">
                                    <Ellipse Width="11" Height="11">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#B3FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="5" Height="5" Fill="#6E9CF0" Stroke="White" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                        </Panel>
                        <Panel Width="16" Height="6">
                            <Rectangle Width="16" Height="2" Fill="#E3EBFA" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center"/>
                            <Panel Name="MenuKnob3" Width="11" Height="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" RenderTransform="translateX(-4.5px)">
                                    <Ellipse Width="11" Height="11">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#B3FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="5" Height="5" Fill="#6E9CF0" Stroke="White" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                        </Panel>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Border Name="QuickWrap" CornerRadius="7" BorderBrush="#9FB3D6" BorderThickness="2"
                            Background="Transparent" VerticalAlignment="Center" Height="30">
                        <Button Name="QuickButton" Classes="iconact flat" Click="OpenQuickSettings" Width="26" Height="26"
                                PointerEntered="IconActionEnter" PointerExited="IconActionLeave"
                                Tag="{DynamicResource Str.quick_title}">
                            <Panel>
                                <Path Name="QuickIcon"
                                      Data="M10 1.4 L3 3.9 V9.4 C3 13.6 6.2 16.9 10 18.4 C13.8 16.9 17 13.6 17 9.4 V3.9 Z M6.7 9.6 L9 11.9 L13.3 7.2"
                                      Stroke="#E3EBFA" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Height="17" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <c:VText Name="QuickLabel" Text="{DynamicResource Str.quick_title}" Opacity="0" IsVisible="False"
                                           Foreground="#E3EBFA" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Button>
                    </Border>
                    <Border Name="KillWrap" CornerRadius="7" BorderBrush="#F5C842" BorderThickness="2"
                            Background="Transparent" VerticalAlignment="Center" Height="30">
                        <Button Name="KillQuickButton" Classes="iconact flat" Click="KillQuickButton_Click" Width="26" Height="26"
                                PointerEntered="IconActionEnter" PointerExited="IconActionLeave"
                                Tag="{DynamicResource Str.kill_switch}">
                            <Panel>
                                <Path Name="KillIcon"
                                      Data="M10 1.4 L3 3.9 V9.4 C3 13.6 6.2 16.9 10 18.4 C13.8 16.9 17 13.6 17 9.4 V3.9 Z M10 6 V10 M10 13 h0.01"
                                      Stroke="#F5C842" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Height="17" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <c:VText Name="KillLabel" Text="{DynamicResource Str.kill_switch}" Opacity="0" IsVisible="False"
                                           Foreground="#F5C842" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Button>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0" ClipToBounds="False">
                    <Path Name="CurrentTabIcon" Data="M2.2,7.4 L8,2.2 L13.8,7.4 M3.7,6.1 V13.6 H12.3 V6.1 M6.5,13.6 V9.5 H9.5 V13.6"
                          Stroke="#CAE2FD" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <c:VText Name="CurrentTabText" FontSize="16" FontWeight="SemiBold" Foreground="#CAE2FD"
                             TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    <Border Name="CurrentTabBar" Width="3.5" Height="26" CornerRadius="1.75" Background="#6E9CF0"
                            VerticalAlignment="Center" Margin="9,0,0,0" BoxShadow="0 0 8 0 #E66E9CF0"/>
                </StackPanel>
            </Grid>

            <Panel Grid.Row="2" Margin="16,0,16,6">
                <c:GlassScroll Name="PanelScroll" HorizontalAlignment="Right"
                               VerticalAlignment="Stretch" Margin="0,0,-14,0" ZIndex="60"/>

                <Grid Name="ConnectPanel" RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Top">

                    <Border Grid.Row="0" Name="NetWarnBox" Classes="glassChip" BorderBrush="#807A2A2E"
                            BoxShadow="0 0 16 0 #40E0575C" Padding="14,10" Margin="0,0,0,10"
                            IsVisible="False" ClipToBounds="True" VerticalAlignment="Top">
                        <StackPanel Name="NetWarnContent" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="M10.29 3.86 L1.82 18 a2 2 0 0 0 1.71 3 h16.94 a2 2 0 0 0 1.71-3 L13.71 3.86 a2 2 0 0 0-3.42 0 z M12 9 v4 M12 17 h0.01"
                                  Stroke="#FF6B6B" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <c:VText Text="{DynamicResource Str.net_off}" Foreground="#FF6B6B" FontSize="13.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,12">
                    <Border Grid.Column="0" Name="SelectedBox" CornerRadius="10" Background="#0E1A38"
                            BorderBrush="#35548C" BorderThickness="1.5" Cursor="{x:Static c:AppCursors.Hand}" ClipToBounds="True"
                            BoxShadow="0 0 9 0 #386E9CF0" VerticalAlignment="Center"
                            PointerEntered="SelectedBox_Enter" PointerExited="SelectedBox_Exit"
                            PointerCaptureLost="SelectedBox_CaptureLost">
                        <Grid RowDefinitions="26,*">
                            <Border Grid.Row="0" Background="#1B2F58" CornerRadius="9,9,0,0">
                                <Grid Margin="10,0">
                                    <TextBlock Text="{DynamicResource Str.selected_server}" Foreground="#9FB3D6"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Spacing="6">
                                        <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                        <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                        <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Name="SelectedHover" Grid.Row="1" CornerRadius="0,0,9,9" Background="#1A2743"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Grid Grid.Row="1" Margin="14,10" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Border Name="SelectedFlagBox" Width="22" Height="16.5" CornerRadius="3.5"
                                                ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,9,0"
                                                IsVisible="False">
                                            <Image Name="SelectedFlag" Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        </Border>
                                        <Border Name="TypeClip" ClipToBounds="True" Width="0" MaxWidth="240"
                                                RenderTransform="translate(0px,2px)"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Name="SelectedName" Foreground="#6E9CF0" FontSize="16"
                                                       FontWeight="Bold" FontFamily="Consolas"
                                                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                        </Border>
                                        <Rectangle Name="TypeCursor" Width="8" Height="17" Fill="#6E9CF0"
                                                   Margin="2,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Name="SelectedAddr" Foreground="#9FB3D6" FontSize="12.5"
                                               FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                               FlowDirection="LeftToRight" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Path Grid.Column="1" Data="M 0,0 L 7,7 L 0,14" Stroke="#9FB3D6" StrokeThickness="3"
                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Name="ConnectButton" Classes="power flat" Margin="20,0,4,0"
                            VerticalAlignment="Center" Click="Power_Click" Background="Transparent"
                            BorderThickness="0" Padding="0" ClipToBounds="False">
                        <Panel ClipToBounds="False">
                            <Border Name="PowerGlow" Width="86" Height="86" CornerRadius="43"
                                    IsHitTestVisible="False" BoxShadow="0 0 30 2 #00E0575C">
                                <Border.Transitions>
                                    <Transitions>
                                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:3" Easing="CubicEaseInOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="PowerFace" Width="86" Height="86" CornerRadius="43"
                                    BorderThickness="4" BorderBrush="#E0575C"
                                    BoxShadow="inset 2 2 0 0 #2C5AA0, inset -2 -2 0 0 #041E42">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#0A2A5E" Offset="0"/>
                                        <GradientStop Color="#1E4D8C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:3" Easing="CubicEaseInOut"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Panel>
                                    <Path Name="PowerIcon"
                                          Data="M20.034,2.357v3.824c3.482,1.798,5.869,5.427,5.869,9.619c0,5.98-4.848,10.83-10.828,10.83 c-5.982,0-10.832-4.85-10.832-10.83c0-3.844,2.012-7.215,5.029-9.136V2.689C4.245,4.918,0.731,9.945,0.731,15.801 c0,7.921,6.42,14.342,14.34,14.342c7.924,0,14.342-6.421,14.342-14.342C29.412,9.624,25.501,4.379,20.034,2.357z M14.795,17.652c1.576,0,1.736-0.931,1.736-2.076V2.08c0-1.148-0.16-2.08-1.736-2.08 c-1.57,0-1.732,0.932-1.732,2.08v13.496C13.062,16.722,13.225,17.652,14.795,17.652z"
                                          Height="34" Stretch="Uniform" Fill="#E0575C"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="Fill" Duration="0:0:1" Easing="CubicEaseInOut"/>
                                            </Transitions>
                                        </Path.Transitions>
                                    </Path>
                                </Panel>
                            </Border>
                            <Panel Name="PulseLayer" IsHitTestVisible="False" Opacity="0">
                                <Border Width="86" Height="86" CornerRadius="43"
                                        BorderThickness="4" BorderBrush="#7CFFC4"/>
                                <Path Data="M20.034,2.357v3.824c3.482,1.798,5.869,5.427,5.869,9.619c0,5.98-4.848,10.83-10.828,10.83 c-5.982,0-10.832-4.85-10.832-10.83c0-3.844,2.012-7.215,5.029-9.136V2.689C4.245,4.918,0.731,9.945,0.731,15.801 c0,7.921,6.42,14.342,14.34,14.342c7.924,0,14.342-6.421,14.342-14.342C29.412,9.624,25.501,4.379,20.034,2.357z M14.795,17.652c1.576,0,1.736-0.931,1.736-2.076V2.08c0-1.148-0.16-2.08-1.736-2.08 c-1.57,0-1.732,0.932-1.732,2.08v13.496C13.062,16.722,13.225,17.652,14.795,17.652z"
                                      Height="34" Stretch="Uniform" Fill="#7CFFC4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Panel>
                    </Button>


                    </Grid>

                    <Grid Grid.Row="3" Height="238" ColumnDefinitions="238,*">
                        <Panel Grid.Column="0" Name="EarthHost" Margin="-12,0,0,14">
                            <c:EarthGlobe Name="Earth"/>
                            <Border Name="IpPopup" CornerRadius="10" BorderThickness="1" Padding="11,7"
                                    Background="#EC0E1A38" BorderBrush="#783D6AD6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsHitTestVisible="False" IsVisible="False"
                                    BoxShadow="0 2 16 0 #80000000">
                                <StackPanel>
                                    <TextBlock Text="PUBLIC IP" FontSize="8.5" FontWeight="SemiBold"
                                               Foreground="#7FA8D8" FontFamily="{DynamicResource UiFont}"
                                               Margin="0,0,0,1"/>
                                    <TextBlock Name="IpPopIp" FontFamily="Consolas" FontWeight="Bold"
                                               FontSize="13" Foreground="#BEDCFF"/>
                                    <c:VText Name="IpPopCity" FontSize="11.5" Foreground="#C8D4E4"
                                               FontFamily="{DynamicResource UiFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Panel>
                        <Panel Grid.Column="1" Margin="6,0,0,0">
                            <Border Name="DiscoBox" Classes="glassChip" Padding="14,9"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M5.6,5.6 L10.4,10.4 M10.4,5.6 L5.6,10.4"
                                          Stroke="#8FA3C8" StrokeThickness="1.5" StrokeLineCap="Round"
                                          Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <c:VText Name="DiscoText" Text="{DynamicResource Str.status_disconnected}"
                                               Foreground="#8FA3C8" FontSize="13.5" MaxWidth="240"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Name="ConnBox" IsHitTestVisible="False" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" IsVisible="False">
                                <Border Classes="glassChip" BorderBrush="#662FDF8F" BoxShadow="0 0 12 0 #802FDF8F" Padding="12,7" HorizontalAlignment="Left" Margin="0,0,0,7">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#662FDF8F" Offset="0"/>
                                                <GradientStop Color="#262FDF8F" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M5,8.3 L7.2,10.4 L11,5.9"
                                              Stroke="#6FF5B8" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <c:VText Text="{DynamicResource Str.status_connected}" Foreground="#7CF7C0" FontSize="13.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Border Classes="glassChip" BorderBrush="#B335D6FF" BoxShadow="0 0 14 0 #9935D6FF" Padding="8,6"
                                            Width="100" ClipToBounds="True" Margin="0,0,6,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#6635D6FF" Offset="0"/>
                                                <GradientStop Color="#2635D6FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M8,4.5 V11 M5.3,8.4 L8,11.1 L10.7,8.4"
                                                      Stroke="#7FE3FF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <c:VText Name="SpeedDownText" Text="0 B/s" Foreground="#BFF0FF" FontSize="11.5"
                                                         FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <c:VText Name="TotalDownText" Text="0 B" Foreground="#8FA3C8" FontSize="10.5"
                                                     FontFamily="{DynamicResource AppFont}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="glassChip" BorderBrush="#B3B06CFF" BoxShadow="0 0 14 0 #99B06CFF" Padding="8,6"
                                            Width="100" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#66B06CFF" Offset="0"/>
                                                <GradientStop Color="#26B06CFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M8,11.5 V5 M5.3,7.6 L8,4.9 L10.7,7.6"
                                                      Stroke="#C99CFF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <c:VText Name="SpeedUpText" Text="0 B/s" Foreground="#D9BAFF" FontSize="11.5"
                                                         FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <c:VText Name="TotalUpText" Text="0 B" Foreground="#8FA3C8" FontSize="10.5"
                                                     FontFamily="{DynamicResource AppFont}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Classes="glassChip" Padding="12,7" Width="100" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse Stroke="#8FA3C8" StrokeThickness="1.5"/>
                                            <Path Data="M8 4.1 V8 L10.7 9.9" Stroke="#8FA3C8" StrokeThickness="1.5"
                                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Panel>
                                        <c:VText Name="ConnTimeText" Text="00:00:00" Foreground="#B9C6E2" FontSize="12.5"
                                                   FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Name="PingButton" Classes="bare" Click="PingButton_Click"
                                        RenderTransformOrigin="50%,50%" ClipToBounds="False"
                                        HorizontalAlignment="Left" Margin="0,7,0,0">
                                    <Panel ClipToBounds="False">
                                        <Border Classes="glassChip" CornerRadius="10"/>
                                        <c:PingRing Name="PingFx" Radius="10" Inset="12" Margin="-12" ClipToBounds="False"/>
                                        <StackPanel Orientation="Horizontal" Margin="13,8">
                                            <Path Name="PingIcon"
                                                  Data="M3,13 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M3,9 A4,4 0 0 1 7,13 M3,5.2 A7.8,7.8 0 0 1 10.8,13"
                                                  Stroke="#8A97AD" StrokeThickness="1.6" StrokeLineCap="Round"
                                                  Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <c:VText Name="PingText" Text="Ping" Foreground="#B9C6E2" FontSize="13"
                                                     FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Panel>
                                </Button>
                            </StackPanel>
                        </Panel>
                    </Grid>
                </Grid>

                <Grid Name="PickerPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                        <Button Grid.Column="0" Classes="live" Click="ClosePicker_Click" Width="26" Height="30"
                                Padding="0" Margin="0,0,2,0">
                            <Path Data="M8 1 L2 7 L8 13" Stroke="#C7D4EC" StrokeThickness="2" StrokeLineCap="Round"
                                  StrokeJoin="Round" Width="9" Height="13" Stretch="Uniform"/>
                        </Button>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.choose_server}" Foreground="White" FontSize="19" FontWeight="Bold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Name="AddButton" Classes="live" Click="ToggleAddMenu_Click" Width="36" Height="36" Padding="0"
                                CornerRadius="12" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.5"
                                Background="{StaticResource GlassFill}">
                            <Button.Styles>
                                <Style Selector="Button /template/ Border#Bd">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.18"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover /template/ Border#Bd">
                                    <Setter Property="Background" Value="{StaticResource GlassHeaderHover}"/>
                                </Style>
                            </Button.Styles>
                            <Panel Name="AddIcon" Width="14" Height="14" RenderTransformOrigin="50%,50%">
                                <Panel.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform"
                                                                       Duration="0:0:0.26" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Panel.Transitions>
                                <Rectangle Name="AddBarH" Width="14" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="#E3EBFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Name="AddBarV" Width="2" Height="14" RadiusX="1" RadiusY="1"
                                           Fill="#E3EBFA" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderTransformOrigin="50%,50%">
                                    <Rectangle.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform"
                                                                           Duration="0:0:0.26" Easing="CubicEaseOut"/>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Rectangle.Transitions>
                                </Rectangle>
                            </Panel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="2,2,0,6">
                        <Path Grid.Column="0" Data="M2,3 H14 V6.5 H2 Z M2,9.5 H14 V13 H2 Z M4,4.75 h0.01 M4,11.25 h0.01"
                              Stroke="#9FB3D6" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" Width="16" Height="16" Margin="10,6,0,0"
                              Stretch="Uniform" VerticalAlignment="Center"/>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.servers}" Foreground="#DCE6F5" FontSize="15"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,6,0,0"/>
                        <Grid Grid.Column="3" Margin="0,8,4,0" VerticalAlignment="Center">
                            <Button Name="SearchToggle" Classes="iconact flat rowact neutral" Click="OpenSearch_Click" Width="28" Height="26" CornerRadius="8"
                                    Padding="0" PointerEntered="IconActionEnter" PointerExited="IconActionLeave"
                                    Tag="{DynamicResource Str.search}">
                                <Panel>
                                    <Path Name="SearchTgIcon" Data="M7 2 A5 5 0 1 0 7 12 A5 5 0 0 0 7 2 M10.8 10.8 L14.5 14.5"
                                          Stroke="#C9D6EE" StrokeThickness="1.7" StrokeLineCap="Round" Width="16" Height="16"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <c:VText Name="SearchTgLabel" Text="{DynamicResource Str.search}" Opacity="0" IsVisible="False"
                                               Foreground="#E3EBFA" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <Border Name="SearchWrap" Height="30" Width="0" CornerRadius="9" Background="#0E1A38"
                                    BorderBrush="#3D6AD6" BorderThickness="1.4" ClipToBounds="True"
                                    IsVisible="False" HorizontalAlignment="Right">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </Border.Resources>
                                <Grid ColumnDefinitions="30,*,Auto">
                                    <Path Grid.Column="0" Data="M7 2 A5 5 0 1 0 7 12 A5 5 0 0 0 7 2 M10.8 10.8 L14.5 14.5"
                                          Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round" Width="14" Height="14"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Name="SearchInput" Background="Transparent" BorderBrush="Transparent"
                                             BorderThickness="0" CornerRadius="0" MinHeight="0" Height="28" MinWidth="118"
                                             Padding="0,0,4,0" FontSize="12.5" Foreground="#EAF2FF" CaretBrush="#6E9CF0"
                                             FocusAdorner="{x:Null}" VerticalContentAlignment="Center"
                                             TextChanged="Search_Changed"/>
                                    <Button Grid.Column="2" Classes="iconact flat" Width="30" Height="28" Padding="0"
                                            Margin="0,0,3,0" Click="CloseSearch_Click"
                                            PointerEntered="SearchClear_Enter" PointerExited="SearchClear_Exit">
                                        <Path Name="SearchClearIcon" Data="M5 5 L15 15 M15 5 L5 15" Stroke="#7E93B8"
                                              StrokeThickness="1.7" StrokeLineCap="Round" Width="13" Height="13"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                        <Button Grid.Column="4" Name="SortBtn" Classes="iconact flat rowact neutral" Click="SortButton_Click" Width="28" Height="26" CornerRadius="8"
                                Padding="0" Margin="0,8,8,0" PointerEntered="IconActionEnter" PointerExited="IconActionLeave"
                                Tag="{DynamicResource Str.sort}">
                            <Panel>
                                <Path Name="SortTgIcon" Data="M3,5 H15 M3,9 H12 M3,13 H8" Stroke="#C9D6EE"
                                      StrokeThickness="1.7" StrokeLineCap="Round" Width="16" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <c:VText Name="SortTgLabel" Text="{DynamicResource Str.sort}" Opacity="0" IsVisible="False"
                                           Foreground="#E3EBFA" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" HorizontalOffset="4" VerticalOffset="4">
                                    <MenuItem Name="SortAddedItem" FlowDirection="RightToLeft" Header="{DynamicResource Str.sort_added}" Click="SortAdded_Click"
                                              ToggleType="Radio" GroupName="SortMode"/>
                                    <MenuItem Name="SortAlphaItem" FlowDirection="RightToLeft" Header="{DynamicResource Str.sort_alpha}" Click="SortAlpha_Click"
                                              ToggleType="Radio" GroupName="SortMode"/>
                                    <MenuItem Name="SortFastestItem" FlowDirection="RightToLeft" Header="{DynamicResource Str.sort_fastest}" Click="SortFastest_Click"
                                              ToggleType="Radio" GroupName="SortMode"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="5" Name="TestAllButton" Classes="bare" Click="TestAll_Click"
                                Height="30" Margin="0,8,0,0" VerticalAlignment="Top" ClipToBounds="False">
                            <Button.Styles>
                                <Style Selector="Button:pointerover Border#TestFill">
                                    <Setter Property="Background" Value="#5C2E8EFF"/>
                                </Style>
                                <Style Selector="Panel#TestScale">
                                    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
                                    <Setter Property="RenderTransform" Value="scale(1,1)"/>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pressed Panel#TestScale">
                                    <Setter Property="RenderTransform" Value="scale(0.95,0.95)"/>
                                </Style>
                            </Button.Styles>
                            <Panel Name="TestScale" ClipToBounds="False">
                                <Border Name="TestFill" CornerRadius="15" Background="#332E8EFF">
                                    <Border.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.3"/>
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                                <Border Name="TestRing" CornerRadius="15" Padding="1.6">
                                    <Border CornerRadius="13.4" Background="#0C1A36" Padding="13,0">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Path Data="M8.5,1 L3,9 H7.5 L6.5,15 L13,6.5 H8 Z" Fill="#FFFFFF"
                                                  Width="13" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Name="TestAllLabel" Text="{DynamicResource Str.test_all}" Foreground="White"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Panel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Name="AddMenu" IsVisible="False" CornerRadius="14" Padding="6"
                            Margin="0,0,0,8" ClipToBounds="True" RenderTransformOrigin="50%,0%"
                            BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.5"
                            Background="{StaticResource GlassFill}">
                        <Grid Name="AddTiles" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                            <Button Name="TilePaste" Grid.Row="0"
                                    Grid.Column="0"
                                    Classes="live" Click="PasteAdd_Click" Height="44" CornerRadius="11"
                                    Margin="3" HorizontalAlignment="Stretch" Padding="10,0"
                                    Background="{StaticResource GlassHeaderHover}"
                                    BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2">
                                <c:VText Text="{DynamicResource Str.paste_clipboard}" FontSize="12.5" FontWeight="SemiBold"
                                         TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#DCE6F5"/>
                            </Button>
                            <Button Name="TileManual" Grid.Row="0"
                                    Grid.Column="1"
                                    Classes="live" Click="OpenManual_Click" Height="44" CornerRadius="11"
                                    Margin="3" HorizontalAlignment="Stretch" Padding="10,0"
                                    Background="{StaticResource GlassHeaderHover}"
                                    BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2">
                                <c:VText Text="{DynamicResource Str.add_manually}" FontSize="12.5" FontWeight="SemiBold"
                                         TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#DCE6F5"/>
                            </Button>
                            <Button Name="TileProjects" Grid.Row="1"
                                    Grid.Column="0"
                                    Classes="live" Click="OpenProjects_Click" Height="44" CornerRadius="11"
                                    Margin="3" HorizontalAlignment="Stretch" Padding="10,0"
                                    Background="{StaticResource GlassHeaderHover}"
                                    BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2">
                                <c:VText Text="{DynamicResource Str.free_projects}" FontSize="12.5" FontWeight="SemiBold"
                                         TextWrapping="Wrap" VerticalAlignment="Center">
                                    <c:VText.Foreground>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#B57BFF" Offset="0"/>
                                            <GradientStop Color="#E45BF0" Offset="0.5"/>
                                            <GradientStop Color="#FF6FB5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </c:VText.Foreground>
                                </c:VText>
                            </Button>
                            <Button Name="TileImport" Grid.Row="1"
                                    Grid.Column="1"
                                    Classes="live" Click="Import_Click" Height="44" CornerRadius="11"
                                    Margin="3" HorizontalAlignment="Stretch" Padding="10,0"
                                    Background="{StaticResource GlassHeaderHover}"
                                    BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2">
                                <c:VText Text="{DynamicResource Str.import_from_file}" FontSize="12.5" FontWeight="SemiBold"
                                         TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#DCE6F5"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Name="SelectionBar" Grid.Row="3" Classes="glassSheet" CornerRadius="14" Padding="8" VerticalAlignment="Bottom"
                            IsVisible="False" ZIndex="90" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Grid.Column="0" Classes="live" Click="SelectionCancel_Click" Height="38"
                                    Background="#001A2743" BorderThickness="0" Padding="10,0" VerticalAlignment="Center">
                                <Path Data="M2,2 L14,14 M14,2 L2,14" Stroke="#9FB3D6" StrokeThickness="1.8"
                                      StrokeLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                            <c:VText Name="SelectionCount" Grid.Column="1" Text="0 selected" Foreground="#E3EBFA"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Classes="live ghost" Click="SelectionShare_Click" Height="38"
                                    Margin="0,0,6,0" FontSize="14" Padding="14,0"
                                    Content="{DynamicResource Str.share_selected}"/>
                            <Button Grid.Column="3" Classes="live" Click="SelectionDelete_Click" Height="38"
                                    Background="#C4362B" BorderBrush="#E05A50" BorderThickness="1" Foreground="White"
                                    FontSize="14" Padding="14,0" Content="{DynamicResource Str.delete}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" Name="GroupScroll" PointerMoved="GroupScroll_PointerMoved"
                                  PointerReleased="GroupScroll_PointerReleased">
                        <ItemsControl Name="GroupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SubGroupVm">
                                    <StackPanel Name="GroupItem" Margin="0,0,0,14">
                                        <Border Name="HeaderBox" Classes="glassHeader" Cursor="{x:Static c:AppCursors.Hand}" Tag="{Binding Id}"
                                                PointerPressed="ToggleGroup" PointerReleased="CardRelease" PointerCaptureLost="CardRelease">
                                            <StackPanel Margin="12,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                                                    <Path Grid.Column="0" Data="M 0,0 L 6,6 L 0,12" Stroke="#9FB3D6"
                                                          StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"
                                                          VerticalAlignment="Center" Margin="2,0,12,0"
                                                          RenderTransformOrigin="50%,50%"
                                                          Classes.open="{Binding IsExpanded}"
                                                          IsVisible="{Binding SubActionsVisible}">
                                                        <Path.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                                                            </Transitions>
                                                        </Path.Transitions>
                                                    </Path>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid Name="NameClip" ClipToBounds="True" Height="30" Margin="0,0,8,0"
                                                              SizeChanged="NameClip_SizeChanged">
                                                            <Canvas Height="18" VerticalAlignment="Center">
                                                                <Canvas.RenderTransform>
                                                                    <TranslateTransform/>
                                                                </Canvas.RenderTransform>
                                                                <TextBlock Name="SubName" Text="{Binding Name}" Foreground="White" FontSize="13"
                                                                           FontWeight="SemiBold" SizeChanged="NameText_SizeChanged"/>
                                                                <TextBlock Name="SubNameGhost" Text="{Binding Name}" Foreground="White" FontSize="13"
                                                                           FontWeight="SemiBold" IsVisible="False"/>
                                                            </Canvas>
                                                            <TextBox Name="SubNameEdit" IsVisible="False" MinHeight="0" Height="30"
                                                                     HorizontalAlignment="Left" ClipToBounds="True"
                                                                     FontSize="13" FontWeight="SemiBold" Padding="10,0"
                                                                     CornerRadius="9"
                                                                     KeyDown="RenameKeyDown" LostFocus="RenameCommit"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding UsageText}" Foreground="#9FB3D6" FontSize="11"
                                                                   IsVisible="{Binding HasUsageText}"/>
                                                    </StackPanel>
                                                    <c:VText Grid.Column="2" Text="{Binding CountText}" Foreground="#9FB3D6"
                                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <Button Grid.Column="3" Classes="iconact flat rowact" Tag="{Binding Id}" Click="PingSub_Click"
                                                            Width="30" Height="30" Padding="0" CornerRadius="9" Margin="0,0,0,0"
                                                            IsVisible="{Binding SubActionsVisible}"
                                                            PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                        <Panel>
                                                            <Path Data="M8.5,1 L3,9 H7.5 L6.5,15 L13,6.5 H8 Z"
                                                                  Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                                                  StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <c:VText Text="{DynamicResource Str.test_sub}" Opacity="0" IsVisible="False"
                                                                     Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="5" Classes="iconact flat rowact" Tag="{Binding Id}" Click="RenameSub_Click"
                                                            Width="30" Height="30" Padding="0" CornerRadius="9" Margin="0,0,2,0"
                                                            IsVisible="{Binding SubActionsVisible}"
                                                            PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                        <Panel>
                                                            <Path Data="M12 20h9 M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"
                                                                  Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                                                  StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <c:VText Text="{DynamicResource Str.rename}" Opacity="0" IsVisible="False"
                                                                     Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="6" Classes="iconact flat rowact" Tag="{Binding Id}" Click="CopySub_Click"
                                                            Width="30" Height="30" Padding="0" CornerRadius="9" Margin="0,0,2,0"
                                                            IsVisible="{Binding SubActionsVisible}"
                                                            PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                        <Panel>
                                                            <Path Data="M20 9h-9a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                                                                  Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                                                  StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <c:VText Text="{DynamicResource Str.copy}" Opacity="0" IsVisible="False"
                                                                     Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="4" Classes="iconact flat rowact" Tag="{Binding Id}" Click="RefreshSub_Click"
                                                            Width="30" Height="30" Padding="0" CornerRadius="9" Margin="0,0,2,0"
                                                            IsVisible="{Binding SubActionsVisible}"
                                                            PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                        <Panel>
                                                            <Path Data="M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15"
                                                                  Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                                                  StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <c:VText Text="{DynamicResource Str.refresh}" Opacity="0" IsVisible="False"
                                                                     Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="7" Classes="iconact flat rowact" Tag="{Binding Id}"
                                                            Width="30" Height="30" Padding="0" CornerRadius="9" Margin="0,0,2,0"
                                                            PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                        <Panel>
                                                            <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                                                                  Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                                                  StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <c:VText Text="{DynamicResource Str.remove}" Opacity="0" IsVisible="False"
                                                                     Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Panel>
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="{DynamicResource Str.del_timed_out}"
                                                                          Tag="{Binding Id}" Click="DeleteGroupDead_Click"/>
                                                                <MenuItem Header="{DynamicResource Str.del_all_group}"
                                                                          Tag="{Binding Id}" Click="DeleteGroupAll_Click"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                                <Grid Height="4" Margin="0,9,0,0" IsVisible="{Binding HasUsageBar}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding RemainingStar}"/>
                                                        <ColumnDefinition Width="{Binding UsedStar}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#3D6AD6" CornerRadius="2"/>
                                                    <Border Grid.Column="1" Background="#243456" CornerRadius="2"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Configs}" IsVisible="{Binding IsExpanded}"
                                                      Loaded="ConfigListLoaded">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="core:ProxyConfig">
                                                    <Border Name="CfgBox" Classes="glassRow" Margin="0,8,0,0" Cursor="{x:Static c:AppCursors.Hand}"
                                                            PointerCaptureLost="CardRelease"
                                                            Tag="{Binding Id}"
                                                            PointerPressed="SelectConfig" PointerReleased="Row_Released"
                                                            BorderThickness="2"
                                                            BorderBrush="{Binding IsChecked, Converter={StaticResource CheckBorder}}">
                                                        <Grid Margin="12,10" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*">
                                                                <Panel Grid.Column="0" Width="30" Height="30"
                                                                       ClipToBounds="False"
                                                                       Margin="0,0,5,0" VerticalAlignment="Center">
                                                                    <Ellipse Classes="pingpulse" Width="14" Height="14"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Fill="{Binding Ping, Converter={StaticResource PingBrush}}">
                                                                        <Ellipse.Effect>
                                                                            <BlurEffect Radius="4"/>
                                                                        </Ellipse.Effect>
                                                                    </Ellipse>
                                                                    <Ellipse Width="10" Height="10"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Fill="{Binding Ping, Converter={StaticResource PingBrush}}"/>
                                                                </Panel>
                                                                <Border Grid.Column="1" Width="24" Height="18" CornerRadius="3.5"
                                                                        ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,14,0"
                                                                        IsVisible="{Binding Name, Converter={StaticResource FlagPresent}}">
                                                                    <Image Source="{Binding Name, Converter={StaticResource Flag}}"
                                                                           Stretch="UniformToFill"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name, Converter={StaticResource FlagName}}"
                                                                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                    <c:VText Foreground="#9FB3D6" FontSize="11" FlowDirection="LeftToRight"
                                                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                             IsVisible="{Binding !Locked}">
                                                                        <c:VText.Text>
                                                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                                                <Binding Path="Address"/>
                                                                                <Binding Path="Port"/>
                                                                            </MultiBinding>
                                                                        </c:VText.Text>
                                                                    </c:VText>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Border Grid.Column="1" CornerRadius="5" Padding="8,2" Margin="16,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding Ping, Converter={StaticResource PingBoxVis}}"
                                                                    Background="{Binding Ping, Converter={StaticResource PingBrush}, ConverterParameter=bg}"
                                                                    BorderBrush="{Binding Ping, Converter={StaticResource PingBrush}, ConverterParameter=border}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding Ping, Converter={StaticResource PingLabel}}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding Ping, Converter={StaticResource PingBrush}}"/>
                                                            </Border>
                                                            <Button Grid.Column="2" Classes="iconact flat rowact" Tag="{Binding Id}"
                                                                    IsVisible="{Binding !Locked}"
                                                                    Click="EditConfig_Click" Width="30" Height="28" CornerRadius="9" Margin="0,0,3,0"
                                                                    Padding="0"
                                                                    PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                                <Panel>
                                                                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z M20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                          Stroke="#6E9CF0" StrokeThickness="1.5" StrokeLineCap="Round"
                                                                          StrokeJoin="Round" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <c:VText Text="{DynamicResource Str.edit}" Opacity="0" IsVisible="False"
                                                                             Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Panel>
                                                            </Button>
                                                            <Button Grid.Column="3" Classes="iconact flat rowact" Tag="{Binding Id}"
                                                                    IsVisible="{Binding !Locked}"
                                                                    Click="CopyConfig_Click" Width="30" Height="28" CornerRadius="9" Margin="0,0,3,0"
                                                                    Padding="0"
                                                                    PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                                <Panel>
                                                                    <Path Data="M20 9h-9a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                                                                          Stroke="#6E9CF0" StrokeThickness="1.5" StrokeLineCap="Round"
                                                                          StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <c:VText Text="{DynamicResource Str.copy}" Opacity="0" IsVisible="False"
                                                                             Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Panel>
                                                            </Button>
                                                            <Button Grid.Column="4" Classes="iconact flat rowact" Tag="{Binding Id}"
                                                                    IsVisible="{Binding !Locked}"
                                                                    Click="ShareConfig_Click" Width="30" Height="28" CornerRadius="9" Margin="0,0,3,0"
                                                                    Padding="0"
                                                                    PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                                <Panel>
                                                                    <Path Data="M8,10 V2 M4.5,5.5 L8,2 L11.5,5.5 M3,11 V13 H13 V11"
                                                                          Stroke="#6E9CF0" StrokeThickness="1.5" StrokeLineCap="Round"
                                                                          StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <c:VText Text="{DynamicResource Str.share_as_file}" Opacity="0" IsVisible="False"
                                                                             Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Panel>
                                                            </Button>
                                                            <Button Grid.Column="5" Classes="iconact flat rowact danger" Tag="{Binding Id}"
                                                                    Click="DeleteServer_Click" Width="30" Height="28" CornerRadius="9" Margin="0,0,0,0"
                                                                    Padding="0"
                                                                    PointerEntered="RowIconEnter" PointerExited="RowIconLeave">
                                                                <Panel>
                                                                    <Path Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                                                                          Stroke="#E57373" StrokeThickness="1.5" StrokeLineCap="Round"
                                                                          StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <c:VText Text="{DynamicResource Str.delete}" Opacity="0" IsVisible="False"
                                                                             Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Panel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer Name="ManualPanel" IsVisible="False">
                    <StackPanel>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                            <Button Grid.Column="0" Classes="live" Click="ManualBack_Click" Width="26" Height="30"
                                    Padding="0" Margin="0,0,2,0">
                                <Path Data="M8 1 L2 7 L8 13" Stroke="#C7D4EC" StrokeThickness="2" StrokeLineCap="Round"
                                      StrokeJoin="Round" Width="9" Height="13" Stretch="Uniform"/>
                            </Button>
                            <c:VText Grid.Column="1" Name="ManualTitle" Text="{DynamicResource Str.add_manually}" Foreground="White"
                                     FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Classes="card">
                            <StackPanel>
                                <c:VText Text="{DynamicResource Str.f_protocol}" Foreground="White" FontSize="14"
                                         FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ComboBox Name="MProtocol" HorizontalAlignment="Stretch" Height="40"
                                          Margin="0,0,0,14" SelectionChanged="ManualProto_Changed">
                                    <ComboBoxItem Content="VLESS" Tag="vless"/>
                                    <ComboBoxItem Content="VMess" Tag="vmess"/>
                                    <ComboBoxItem Content="Trojan" Tag="trojan"/>
                                    <ComboBoxItem Content="Shadowsocks" Tag="shadowsocks"/>
                                    <ComboBoxItem Content="WireGuard" Tag="wireguard"/>
                                    <ComboBoxItem Content="Hysteria2" Tag="hysteria2"/>
                                    <ComboBoxItem Content="HTTP" Tag="http"/>
                                    <ComboBoxItem Content="SOCKS" Tag="socks"/>
                                </ComboBox>
                            <StackPanel Name="MNameRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_name}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MName"/>
                            </StackPanel>
                            <StackPanel Name="MAddressRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_address}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MAddress"/>
                            </StackPanel>
                            <StackPanel Name="MPortRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_port}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPort"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Name="AuthCard">
                            <StackPanel>
                                <c:VText Text="{DynamicResource Str.manual_auth}" Foreground="White" FontSize="14"
                                         FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <StackPanel Name="MUuidRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_uuid}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MUuid"/>
                            </StackPanel>
                            <StackPanel Name="MPasswordRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_password}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPassword" PasswordChar="•"/>
                            </StackPanel>
                            <StackPanel Name="MUsernameRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_username}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MUsername"/>
                            </StackPanel>
                            <StackPanel Name="MObfsRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_obfs}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MObfs" Watermark="salamander"/>
                            </StackPanel>
                            <StackPanel Name="MObfsPwRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_obfs_pw}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MObfsPw"/>
                            </StackPanel>
                            <StackPanel Name="MMethodRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_cipher}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MMethod"/>
                            </StackPanel>
                            <StackPanel Name="MFlowRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_flow}" Classes="muted" FontSize="12"/>
                                <ComboBox Name="MFlow" HorizontalAlignment="Stretch" Height="40">
                                    <ComboBoxItem Content="none" Tag=""/>
                                    <ComboBoxItem Content="xtls-rprx-vision" Tag="xtls-rprx-vision"/>
                                    <ComboBoxItem Content="xtls-rprx-vision-udp443" Tag="xtls-rprx-vision-udp443"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Name="MEncryptionRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_encryption}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MEncryption" Watermark="none"/>
                            </StackPanel>
                            <StackPanel Name="MAlterIdRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_alterid}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MAlterId" Watermark="0"/>
                            </StackPanel>
                            <StackPanel Name="MPrivKeyRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_privkey}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPrivKey" PasswordChar="•"/>
                            </StackPanel>
                            <StackPanel Name="MPeerKeyRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_peerkey}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPeerKey"/>
                            </StackPanel>
                            <StackPanel Name="MPskRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_psk}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPsk" PasswordChar="•"/>
                            </StackPanel>
                            <StackPanel Name="MWgAddressRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_wgaddr}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MWgAddress"/>
                            </StackPanel>
                            <StackPanel Name="MMtuRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_mtu}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MMtu"/>
                            </StackPanel>
                            <StackPanel Name="MReservedRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_reserved}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MReserved"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Name="TransportCard">
                            <StackPanel>
                                <c:VText Text="{DynamicResource Str.f_transport}" Foreground="White" FontSize="14"
                                         FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ComboBox Name="MNetwork" HorizontalAlignment="Stretch" Height="40"
                                          Margin="0,0,0,14" SelectionChanged="ManualNet_Changed">
                                    <ComboBoxItem Content="TCP" Tag="tcp"/>
                                    <ComboBoxItem Content="WebSocket" Tag="ws"/>
                                    <ComboBoxItem Content="gRPC" Tag="grpc"/>
                                    <ComboBoxItem Content="HTTP/2" Tag="http"/>
                                    <ComboBoxItem Content="QUIC" Tag="quic"/>
                                    <ComboBoxItem Content="kcp" Tag="kcp"/>
                                    <ComboBoxItem Content="HTTPUpgrade" Tag="httpupgrade"/>
                                    <ComboBoxItem Content="xhttp" Tag="xhttp"/>
                                </ComboBox>
                            <StackPanel Name="MPathRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_path}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPath"/>
                            </StackPanel>
                            <StackPanel Name="MHostRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_hosthdr}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MHost"/>
                            </StackPanel>
                            <StackPanel Name="MServiceNameRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_grpc}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MServiceName"/>
                            </StackPanel>
                            <StackPanel Name="MModeRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_mode}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MMode"/>
                            </StackPanel>
                            <StackPanel Name="MHeaderTypeRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_header}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MHeaderType"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Name="TlsCard">
                            <StackPanel>
                                <c:VText Text="{DynamicResource Str.f_security}" Foreground="White" FontSize="14"
                                         FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Border Classes="glassInset" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <RadioButton Classes="seg" Name="ScNone" GroupName="Sec"
                                                     Content="None" Tag="none" Click="ManualField_Click"/>
                                        <RadioButton Classes="seg" Name="ScTls" GroupName="Sec"
                                                     Content="TLS" Tag="tls" Click="ManualField_Click"/>
                                        <RadioButton Classes="seg" Name="ScReality" GroupName="Sec"
                                                     Content="Reality" Tag="reality" Click="ManualField_Click"/>
                                    </StackPanel>
                                </Border>
                            <StackPanel Name="MSniRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_sni}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MSni"/>
                            </StackPanel>
                            <StackPanel Name="MAlpnRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_alpn}" Classes="muted" FontSize="12"/>
                                <ComboBox Name="MAlpn" HorizontalAlignment="Stretch" Height="40">
                                    <ComboBoxItem Content="none" Tag=""/>
                                    <ComboBoxItem Content="h2,http/1.1" Tag="h2,http/1.1"/>
                                    <ComboBoxItem Content="h3" Tag="h3"/>
                                    <ComboBoxItem Content="h3,h2,http/1.1" Tag="h3,h2,http/1.1"/>
                                    <ComboBoxItem Content="h2" Tag="h2"/>
                                    <ComboBoxItem Content="http/1.1" Tag="http/1.1"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Name="MFingerprintRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_fingerprint}" Classes="muted" FontSize="12"/>
                                <ComboBox Name="MFingerprint" HorizontalAlignment="Stretch" Height="40">
                                    <ComboBoxItem Content="none" Tag=""/>
                                    <ComboBoxItem Content="chrome" Tag="chrome"/>
                                    <ComboBoxItem Content="firefox" Tag="firefox"/>
                                    <ComboBoxItem Content="safari" Tag="safari"/>
                                    <ComboBoxItem Content="ios" Tag="ios"/>
                                    <ComboBoxItem Content="android" Tag="android"/>
                                    <ComboBoxItem Content="edge" Tag="edge"/>
                                    <ComboBoxItem Content="360" Tag="360"/>
                                    <ComboBoxItem Content="qq" Tag="qq"/>
                                    <ComboBoxItem Content="random" Tag="random"/>
                                    <ComboBoxItem Content="randomized" Tag="randomized"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Name="MPbkRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_pbk}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MPbk"/>
                            </StackPanel>
                            <StackPanel Name="MSidRow" Spacing="6" Margin="0,0,0,10">
                                <c:VText Text="{DynamicResource Str.f_sid}" Classes="muted" FontSize="12"/>
                                <TextBox Name="MSid"/>
                            </StackPanel>
                            <StackPanel Name="MInsecureRow" Margin="0,2,0,4">
                                <CheckBox Name="MInsecure" Content="{DynamicResource Str.f_insecure}"
                                          Foreground="#C9D6EE" FontSize="12.5"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <Button Grid.Column="0" Classes="live" Click="ManualBack_Click" Height="40"
                                    CornerRadius="11" Margin="0,0,7,0" HorizontalAlignment="Stretch"
                                    Content="{DynamicResource Str.cancel}"/>
                            <Button Grid.Column="1" Name="ManualSave" Classes="live" Click="ManualSave_Click" Height="40"
                                    CornerRadius="11" Margin="7,0,0,0" HorizontalAlignment="Stretch"
                                    Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassEdge}"
                                    BorderThickness="1.5" Content="{DynamicResource Str.save}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Name="SettingsPanel" IsVisible="False">
                    <StackPanel>

                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str.fragment}" Foreground="White" FontSize="13.5"/>
                                        <c:VText Text="{DynamicResource Str.fragment_sub}" Classes="muted" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <c:GlassSwitch Grid.Column="1" Name="FragmentToggle"
                                                  VerticalAlignment="Center" IsCheckedChanged="Fragment_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorder}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str.split}" Foreground="White" FontSize="13.5"/>
                                        <c:VText Text="{DynamicResource Str.split_sub}" Classes="muted" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <c:GlassSwitch Grid.Column="1" Name="SplitToggle"
                                                  VerticalAlignment="Center" IsCheckedChanged="Split_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorder}"/>
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Str.sniffing}" Foreground="White" FontSize="13.5"/>
                                            <c:VText Text="{DynamicResource Str.sniffing_sub}" Classes="muted" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <c:GlassSwitch Grid.Column="1" Name="SniffToggle"
                                                      VerticalAlignment="Center" IsCheckedChanged="Sniff_Changed"/>
                                    </Grid>
                                    <Border Name="SniffReveal" ClipToBounds="True" Height="0">
                                        <StackPanel Name="SniffInner" Spacing="14" Margin="0,14,0,0" Opacity="0">
                                            <WrapPanel Name="SniffChips">
                                                <ToggleButton Classes="chip" Name="SniffTls" Content="TLS" Margin="0,0,10,0" IsCheckedChanged="SniffProto_Changed"/>
                                                <ToggleButton Classes="chip" Name="SniffHttp" Content="HTTP" Margin="0,0,10,0" IsCheckedChanged="SniffProto_Changed"/>
                                                <ToggleButton Classes="chip" Name="SniffQuic" Content="QUIC" Margin="0,0,10,0" IsCheckedChanged="SniffProto_Changed"/>
                                                <ToggleButton Classes="chip" Name="SniffFakeDns" Content="FakeDNS" IsCheckedChanged="SniffProto_Changed"/>
                                            </WrapPanel>
                                            <Grid Name="RouteOnlyRow" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{DynamicResource Str.route_only}" Foreground="White"
                                                           FontSize="13.5" VerticalAlignment="Center"/>
                                                <c:GlassSwitch Grid.Column="1" Name="RouteOnlyToggle"
                                                              VerticalAlignment="Center" IsCheckedChanged="RouteOnly_Changed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource CardBorder}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str.kill_switch}" Foreground="White" FontSize="13.5"/>
                                        <c:VText Text="{DynamicResource Str.kill_switch_sub}" Classes="muted" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <c:GlassSwitch Grid.Column="1" Name="KillToggle"
                                                  VerticalAlignment="Center" IsCheckedChanged="Kill_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorder}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str.auto_fastest}" Foreground="White" FontSize="13.5"/>
                                        <c:VText Text="{DynamicResource Str.auto_fastest_sub}" Classes="muted" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <c:GlassSwitch Grid.Column="1" Name="AutoSelectToggle"
                                                  VerticalAlignment="Center" IsCheckedChanged="AutoSelect_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorder}"/>
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Str.mux}" Foreground="White" FontSize="13.5"/>
                                            <c:VText Text="{DynamicResource Str.mux_sub}" Classes="muted" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <c:GlassSwitch Grid.Column="1" Name="MuxToggle"
                                                      VerticalAlignment="Center" IsCheckedChanged="Mux_Changed"/>
                                    </Grid>
                                    <Border Name="MuxReveal" ClipToBounds="True" Height="0">
                                        <Grid Name="MuxInner" ColumnDefinitions="*,132" Margin="0,14,0,0" Opacity="0">
                                            <c:VText Grid.Column="0" Text="{DynamicResource Str.mux_concurrency}" Classes="muted" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Name="MuxField" Height="36" CornerRadius="10"
                                                    Background="#101E3E" BorderBrush="#35548C" BorderThickness="1">
                                                <Border.Resources>
                                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                </Border.Resources>
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                                    </Transitions>
                                                </Border.Transitions>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                    <TextBox Grid.Column="0" Name="MuxBox" MaxLength="3"
                                                             Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                             CornerRadius="0" MinHeight="0" Height="34" Padding="11,0,4,0"
                                                             FontSize="13.5" Foreground="#E3EBFA" FocusAdorner="{x:Null}"
                                                             VerticalContentAlignment="Center"
                                                             TextChanged="MuxBox_Changed" GotFocus="MuxBox_GotFocus"
                                                             LostFocus="MuxBox_LostFocus"/>
                                                    <Border Grid.Column="1" Width="1" Background="#22345B" Margin="0,8"/>
                                                    <Button Grid.Column="2" Classes="iconact flat" Width="26" Height="34"
                                                            Click="MuxStep_Up">
                                                        <Path Data="M1 6 L6 1 L11 6" Stroke="#9FB3D6" StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round" Width="11" Height="7"
                                                              Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Grid.Column="3" Classes="iconact flat" Width="26" Height="34"
                                                            Click="MuxStep_Down" Margin="0,0,2,0">
                                                        <Path Data="M1 1 L6 6 L11 1" Stroke="#9FB3D6" StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round" Width="11" Height="7"
                                                              Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource Str.geo_files}" Foreground="White" FontSize="14.5"
                                           FontWeight="SemiBold"/>
                                <c:VText Text="{DynamicResource Str.geo_hint}" Classes="muted" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="geoip.dat" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                        <c:VText Name="GeoipStatus" Text="" Classes="muted" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="live ghost" Content="{DynamicResource Str.change}"
                                            Click="ChangeGeoip" FontSize="12" Padding="10,5" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Classes="live ghost" Content="{DynamicResource Str.reset}"
                                            Click="ResetGeoip" FontSize="12" Padding="10,5"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="geosite.dat" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                        <c:VText Name="GeositeStatus" Text="" Classes="muted" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="live ghost" Content="{DynamicResource Str.change}"
                                            Click="ChangeGeosite" FontSize="12" Padding="10,5" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Classes="live ghost" Content="{DynamicResource Str.reset}"
                                            Click="ResetGeosite" FontSize="12" Padding="10,5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource Str.advanced}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,120">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str.mixed_port}" Classes="muted" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Name="PortField" Height="36" CornerRadius="10"
                                            Background="#101E3E" BorderBrush="#35548C" BorderThickness="1">
                                        <Border.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </Border.Resources>
                                        <Border.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <TextBox Grid.Column="0" Name="PortBox" MaxLength="5"
                                                     Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                     CornerRadius="0" MinHeight="0" Height="34" Padding="11,0,4,0"
                                                     FontSize="13.5" Foreground="#E3EBFA" FocusAdorner="{x:Null}"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="PortBox_Changed" GotFocus="PortBox_GotFocus"
                                                     LostFocus="PortBox_LostFocus"/>
                                            <Border Grid.Column="1" Width="1" Background="#22345B" Margin="0,8"/>
                                            <Button Grid.Column="2" Classes="iconact flat" Width="26" Height="34"
                                                    Click="PortStep_Up">
                                                <Path Data="M1 6 L6 1 L11 6" Stroke="#9FB3D6" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Width="11" Height="7"
                                                      Stretch="Uniform"/>
                                            </Button>
                                            <Button Grid.Column="3" Classes="iconact flat" Width="26" Height="34"
                                                    Click="PortStep_Down" Margin="0,0,2,0">
                                                <Path Data="M1 1 L6 6 L11 1" Stroke="#9FB3D6" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Width="11" Height="7"
                                                      Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Name="ToolsPanel" IsVisible="False">
                    <StackPanel>
                        <Border Name="ToolCf" Classes="card" Cursor="{x:Static c:AppCursors.Hand}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Transparent"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Path Data="M10 1.8 A8.2 8.2 0 1 0 10 18.2 A8.2 8.2 0 0 0 10 1.8 Z M2 10 H18 M10 1.8 C13 5 13 15 10 18.2 M10 1.8 C7 5 7 15 10 18.2"
                                          Stroke="{StaticResource AccentSoft}" StrokeThickness="1.8" StrokeLineCap="Round"
                                          StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource Str.cf_title}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.cf_hint}" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="M 0,0 L 6,6 L 0,12" Stroke="#9FB3D6" StrokeThickness="2.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Name="ToolQuality" Classes="card" Cursor="{x:Static c:AppCursors.Hand}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Transparent"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Path Data="M3 17 V11 M8.5 17 V6 M14 17 V13 M19 17 V3"
                                          Stroke="{StaticResource AccentSoft}" StrokeThickness="1.8" StrokeLineCap="Round"
                                          StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource Str.q_title}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.q_hint}" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="M 0,0 L 6,6 L 0,12" Stroke="#9FB3D6" StrokeThickness="2.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Classes="card">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Transparent"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Path Data="M12,2 L20,5 V11 C20,16.5 16.6,20.6 12,22 C7.4,20.6 4,16.5 4,11 V5 Z M9.4,9.6 L14.6,14.8 M14.6,9.6 L9.4,14.8"
                                          Stroke="{StaticResource AccentSoft}" StrokeThickness="1.8" StrokeLineCap="Round"
                                          StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource Str.adblock_title}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.adblock_sub}" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <c:GlassSwitch Grid.Column="2" Name="AdBlockToggle"
                                              VerticalAlignment="Center" IsCheckedChanged="AdBlock_Changed"/>
                            </Grid>
                            <Border Height="1" Background="#1E3157" Margin="0,14,0,14"/>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Transparent"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Path Data="M12 2.5 A9.5 9.5 0 1 0 12 21.5 A9.5 9.5 0 0 0 12 2.5 Z M2.5 12 H21.5 M12 2.5 C15.2 5.8 15.2 18.2 12 21.5 M12 2.5 C8.8 5.8 8.8 18.2 12 21.5 M7 15.5 L12 12 L17 15.5"
                                          Stroke="{StaticResource AccentSoft}" StrokeThickness="1.6" StrokeLineCap="Round"
                                          StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource Str.dns_title}" Foreground="White"
                                               FontSize="14.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.dns_hint}" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <c:GlassSwitch Grid.Column="2" Name="DnsToggle"
                                              VerticalAlignment="Center" IsCheckedChanged="Dns_Changed"/>
                            </Grid>
                            <Border Height="1" Background="#1E3157" Margin="0,14,0,14"/>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Transparent"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Image Source="avares://GRoute/Assets/toricon.png"
                                           Width="21" Height="21" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource Str.tor_title}" Foreground="White"
                                               FontSize="14.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.tor_hint}" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <c:GlassSwitch Grid.Column="2" Name="TorToggle"
                                              VerticalAlignment="Center" IsCheckedChanged="Tor_Changed"/>
                            </Grid>

                            <StackPanel Name="TorExitWrap" IsVisible="False" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Str.tor_exit}" Classes="muted"
                                           FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox Name="TorExitBox" HorizontalAlignment="Stretch" Height="38"
                                          SelectionChanged="TorExit_Changed">
                                    <ComboBoxItem Content="{DynamicResource Str.tor_exit_any}" Tag=""/>
                                    <ComboBoxItem Content="Germany" Tag="de"/>
                                    <ComboBoxItem Content="Netherlands" Tag="nl"/>
                                    <ComboBoxItem Content="France" Tag="fr"/>
                                    <ComboBoxItem Content="Sweden" Tag="se"/>
                                    <ComboBoxItem Content="Switzerland" Tag="ch"/>
                                    <ComboBoxItem Content="Finland" Tag="fi"/>
                                    <ComboBoxItem Content="Romania" Tag="ro"/>
                                    <ComboBoxItem Content="United Kingdom" Tag="gb"/>
                                    <ComboBoxItem Content="United States" Tag="us"/>
                                    <ComboBoxItem Content="Canada" Tag="ca"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Str.tor_exit_warn}" Classes="muted"
                                           FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Name="UsagePanel" IsVisible="False">
                    <StackPanel>
                        <Border Classes="card" CornerRadius="12">
                            <Grid ColumnDefinitions="*,Auto,*">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="{DynamicResource Str.usage_all_time}" Classes="muted" FontSize="11.5"/>
                                    <TextBlock Name="AllTimeText" Text="0 B" Foreground="#C9D6EE"
                                               FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Name="TopConfigBox" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Margin="8,0,8,0" IsVisible="False">
                                    <TextBlock Text="{DynamicResource Str.usage_most_used}" Classes="muted"
                                               FontSize="11.5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <Border Name="TopConfigFlagBox" Width="18" Height="13" CornerRadius="3"
                                                ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0"
                                                IsVisible="False">
                                            <Image Name="TopConfigFlag" Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        </Border>
                                        <c:VText Name="TopConfigName" Foreground="#DCE6F5" FontSize="13"
                                                 FontWeight="SemiBold" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis" MaxWidth="126"/>
                                    </StackPanel>
                                    <TextBlock Name="TopConfigUsage" Foreground="#6E9CF0" FontSize="12"
                                               HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource Str.usage_vpn}" Classes="muted" FontSize="11.5"
                                               HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Spacing="6" Margin="0,2,0,0">
                                        <Path Data="M3.8,8.6 V5.6 A4.2,4.2 0 0 1 12.2,5.6 V8.6 H10.1 V5.6 A2.1,2.1 0 0 0 5.9,5.6 V8.6 Z M3.4,8.4 H12.6 A1.5,1.5 0 0 1 14.1,9.9 V14.2 A1.5,1.5 0 0 1 12.6,15.7 H3.4 A1.5,1.5 0 0 1 1.9,14.2 V9.9 A1.5,1.5 0 0 1 3.4,8.4 Z"
                                              Fill="#2FDF8F" Width="15" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Name="VpnTotalText" Text="0 B" Foreground="#2FDF8F"
                                                   FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="Auto,12,Auto" Margin="0,0,0,12">
                            <Border Grid.Column="0" Classes="glassInset" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <RadioButton Classes="seg" Name="RangeToday" GroupName="UsageRange"
                                                 Content="{DynamicResource Str.range_today}" IsChecked="True"
                                                 VerticalAlignment="Stretch" Click="Range_Today"/>
                                    <RadioButton Classes="seg" Name="RangeWeek" GroupName="UsageRange"
                                                 Content="{DynamicResource Str.range_7d}"
                                                 VerticalAlignment="Stretch" Click="Range_Week"/>
                                    <RadioButton Classes="seg" Name="RangeMonth" GroupName="UsageRange"
                                                 Content="{DynamicResource Str.range_30d}"
                                                 VerticalAlignment="Stretch" Click="Range_Month"/>
                                    <RadioButton Classes="seg" Name="RangeCustom" GroupName="UsageRange"
                                                 Content="{DynamicResource Str.range_custom}"
                                                 VerticalAlignment="Stretch" Click="Range_Custom"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card" Margin="0" CornerRadius="10" Padding="12,7"
                                    MinWidth="176">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="{DynamicResource Str.usage_download}"
                                                   Classes="muted" FontSize="12.5" HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Name="UsageDownText" Foreground="#DCE6F5"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str.usage_upload}"
                                                   Classes="muted" FontSize="12.5" HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Name="UsageUpText" Foreground="#DCE6F5"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Name="CustomDates" Orientation="Horizontal" Margin="0,0,0,10" IsVisible="False">
                            <c:VText Text="{DynamicResource Str.usage_from}" Classes="muted" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <c:GlassDatePicker Name="FromDate" Width="130" Margin="0,0,12,0"
                                               SelectedDateChanged="CustomDateChanged"/>
                            <c:VText Text="{DynamicResource Str.usage_to}" Classes="muted" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <c:GlassDatePicker Name="ToDate" Width="130"
                                               SelectedDateChanged="CustomDateChanged"/>
                        </StackPanel>

<TextBlock Name="NoDataText" Text="{DynamicResource Str.usage_no_data}" Classes="muted"
                                   FontSize="13" IsVisible="False" Margin="0,6,0,0"/>

                        <Border Classes="card" CornerRadius="12" Padding="12,14,12,12" Margin="0,4,0,0">
                            <StackPanel>
                                <Grid Name="ChartGrid" Height="150"/>
                                <Canvas Name="LabelCanvas" Height="18" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Str.usage_hint}" Classes="muted" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Name="ProjectsPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                        <Button Grid.Column="0" Classes="live" Click="CloseProjects_Click" Padding="6,4" Margin="0,0,10,0">
                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="{StaticResource TextMuted}" StrokeThickness="3"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Button>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.free_projects}" Foreground="White" FontSize="19"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Classes="glassInset" Padding="4" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <RadioButton Classes="seg" Name="ProjAether" GroupName="Projects" Content="Aether" IsChecked="True"
                                         IsCheckedChanged="Project_Changed"/>
                            <RadioButton Classes="seg" Name="ProjWarp" GroupName="Projects" Content="{DynamicResource Str.legacy_warp}"
                                         IsCheckedChanged="Project_Changed"/>
                            <RadioButton Classes="seg" Name="ProjTor" GroupName="Projects" Content="{DynamicResource Str.tor_nodes}"
                                         IsCheckedChanged="Project_Changed"/>
                            <RadioButton Classes="seg" Name="ProjPsiphon" GroupName="Projects" Content="Psiphon"
                                         IsVisible="False"
                                         IsCheckedChanged="Project_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Name="ProjBox" CornerRadius="10" Background="#0E1A38"
                            BorderBrush="#35548C" BorderThickness="1.5" ClipToBounds="True"
                            BoxShadow="0 0 9 0 #386E9CF0" Margin="0,0,0,10">
                      <Grid RowDefinitions="26,Auto">
                        <Border Grid.Row="0" Background="#1B2F58" CornerRadius="9,9,0,0">
                            <Grid Margin="10,0">
                                <TextBlock Name="ProjTitle" Text="Aether" Foreground="#9FB3D6"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                    <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                    <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="14,10" Spacing="8">
                            <TextBlock Name="ProjDesc" Classes="muted" TextWrapping="Wrap" LineHeight="19"/>
                            <StackPanel Name="ProjLinkWrap" Orientation="Horizontal" Spacing="6">
                                <Path Data="M9 3 H13 V7 M13 3 L6.5 9.5 M11 9 V12.5 H3.5 V5 H7" Stroke="#6E9CF0"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                <Button Classes="bare" Click="ProjLink_Click" Padding="0" Background="Transparent" Cursor="{x:Static c:AppCursors.Hand}">
                                    <TextBlock Name="ProjLinkText" Text="github.com/CluvexStudio/Aether" Foreground="#6E9CF0"
                                               FontSize="12" TextDecorations="Underline"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Grid.Row="2" Name="PsiphonBox" IsVisible="False" CornerRadius="10" Background="#0E1A38"
                            BorderBrush="#35548C" BorderThickness="1.5" ClipToBounds="True"
                            BoxShadow="0 0 9 0 #386E9CF0" Margin="0,0,0,10">
                      <Grid RowDefinitions="26,Auto">
                        <Border Grid.Row="0" Background="#1B2F58" CornerRadius="9,9,0,0">
                            <Grid Margin="10,0">
                                <TextBlock Text="Psiphon" Foreground="#9FB3D6" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                    <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                    <Ellipse Width="9" Height="9" Fill="#3D6AD6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="14,10" Spacing="8">
                            <TextBlock Text="{DynamicResource Str.psiphon_hint}" Classes="muted"
                                       TextWrapping="Wrap" LineHeight="17"/>
                            <TextBlock Text="{DynamicResource Str.psiphon_region}" Classes="muted"
                                       FontSize="12" Margin="0,2,0,0"/>
                            <ComboBox Name="PsiphonRegion" HorizontalAlignment="Stretch" Height="38"
                                      SelectionChanged="PsiphonRegion_Changed">
                                <ComboBoxItem Content="{DynamicResource Str.tor_exit_any}" Tag=""/>
                                <ComboBoxItem Content="Germany" Tag="DE"/>
                                <ComboBoxItem Content="Netherlands" Tag="NL"/>
                                <ComboBoxItem Content="France" Tag="FR"/>
                                <ComboBoxItem Content="United Kingdom" Tag="GB"/>
                                <ComboBoxItem Content="United States" Tag="US"/>
                                <ComboBoxItem Content="Canada" Tag="CA"/>
                                <ComboBoxItem Content="Sweden" Tag="SE"/>
                                <ComboBoxItem Content="Japan" Tag="JP"/>
                                <ComboBoxItem Content="Singapore" Tag="SG"/>
                                <ComboBoxItem Content="India" Tag="IN"/>
                            </ComboBox>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Grid.Row="2" Name="TorNodeBox" IsVisible="False" CornerRadius="10" Background="#0E1A38"
                            BorderBrush="#35548C" BorderThickness="1.5" ClipToBounds="True"
                            BoxShadow="0 0 9 0 #386E9CF0" Margin="0,0,0,10">
                      <Grid RowDefinitions="26,Auto">
                        <Border Grid.Row="0" Background="#1B2F58" CornerRadius="9,9,0,0">
                            <Grid Margin="10,0">
                                <TextBlock Text="{DynamicResource Str.tor_nodes}" Foreground="#9FB3D6"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Name="TorNodeCount" Text="0" Foreground="#3D6AD6" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="14,10" Spacing="8">
                            <TextBlock Text="{DynamicResource Str.tor_nodes_hint}" Classes="muted"
                                       TextWrapping="Wrap" LineHeight="17"/>
                            <Button Name="TorPickOpen" Classes="live" Click="TorPickOpen_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Height="38" CornerRadius="9" Margin="0,4,0,0" Padding="11,0"
                                    Background="#0A1730" BorderBrush="#1E3157" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Name="TorPickSummary"
                                               Text="{DynamicResource Str.tor_pick_open}" Foreground="#9FB3D6"
                                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0"/>
                                    <Path Grid.Column="1" Data="M 0,0 L 6,6 L 0,12" Stroke="#6E9CF0"
                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,26">
                        <c:StartOrb Name="ProjOrb" Width="200" Height="200" ClipToBounds="False"
                                    Click="ProjectStart_Click"/>
                        <TextBlock Name="ProjHint" Foreground="{StaticResource Danger}" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center" IsVisible="False" MaxWidth="330"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Name="SubsPanel" IsVisible="False" RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                        <Button Grid.Column="0" Classes="live" Click="CloseSubs_Click" Padding="6,4" Margin="0,0,10,0">
                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="{StaticResource TextMuted}" StrokeThickness="3"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Button>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.subscriptions}" Foreground="White" FontSize="19"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Classes="card" Padding="14">
                        <StackPanel Spacing="8">
                            <c:VText Text="{DynamicResource Str.sub_url}" Classes="muted"/>
                            <TextBox Name="SubUrl" Watermark="https://..."/>
                            <TextBox Name="SubNameBox" Watermark="Name (optional)"/>
                            <Button Classes="live primary" Content="{DynamicResource Str.add_and_fetch}" Click="AddSub_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl Name="SubList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="core:Subscription">
                                    <Border Name="SubRow" Classes="card" Padding="13,11" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UsageText}" Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="icon" Click="RefreshSub_Click" Tag="{Binding Id}"
                                                    Width="30" Height="30" Padding="0" ToolTip.Tip="Refresh">
                                                <Path Data="M13.5,8 A5.5,5.5 0 1 1 11.6,3.9 M13.5,1.5 V4.4 H10.6"
                                                      Stroke="{StaticResource AccentSoft}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Button>
                                            <Button Grid.Column="2" Classes="icon" Click="DeleteSub_Click" Tag="{Binding Id}"
                                                    Width="30" Height="30" Padding="0">
                                                <Path Data="M 3,4 H 13 M 6,4 V 2.5 H 10 V 4 M 4.5,4 V 13 H 11.5 V 4"
                                                      Stroke="{StaticResource Danger}" StrokeThickness="1.4"
                                                      StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Name="ScannerPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                        <Button Grid.Column="0" Classes="live" Click="CloseScanner_Click" Padding="7" Margin="0,0,10,0">
                            <Path Data="M8 1 L2 7 L8 13" Stroke="#C7D4EC" StrokeThickness="2" StrokeLineCap="Round"
                                  StrokeJoin="Round" Width="10" Height="14" Stretch="Uniform"/>
                        </Button>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.cf_title}" Foreground="White" FontSize="17"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Classes="card">
                        <StackPanel>
                            <c:VText Text="{DynamicResource Str.cf_pool}" Foreground="{StaticResource TextMuted}"
                                       FontSize="12.5" Margin="0,0,0,10"/>
                            <Border Classes="glassInset" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <RadioButton Classes="seg" Name="Pool100" GroupName="ScanPool" Content="100" Click="Pool_Set" Tag="100"/>
                                    <RadioButton Classes="seg" Name="Pool300" GroupName="ScanPool" Content="300" Click="Pool_Set" Tag="300" IsChecked="True"/>
                                    <RadioButton Classes="seg" Name="Pool600" GroupName="ScanPool" Content="600" Click="Pool_Set" Tag="600"/>
                                    <RadioButton Classes="seg" Name="Pool1000" GroupName="ScanPool" Content="1000" Click="Pool_Set" Tag="1000"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                <Button Name="ScanButton" Classes="live primary" Content="{DynamicResource Str.cf_scan}" Click="ScanCloudflare"
                                        Padding="22,8"/>
                                <Button Name="ScanStopButton" Classes="live" Content="{DynamicResource Str.cf_stop}" Click="StopScan"
                                        IsVisible="False" Background="#C4362B" BorderBrush="#E05A50" BorderThickness="1"
                                        Foreground="White" Padding="16,7"/>
                                <c:VText Name="ScanStatus" Foreground="#8FA3C8" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Name="ScanProgressTrack" Height="5" CornerRadius="2.5" Background="#16233F"
                                    Margin="0,12,0,0" IsVisible="False">
                                <Border Name="ScanProgressBar" Height="5" CornerRadius="2.5" Background="#3D6AD6"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <c:VText Grid.Row="2" Name="ScanResultsTitle" Text="{DynamicResource Str.cf_results}" Foreground="White" FontSize="14"
                               FontWeight="SemiBold" Margin="2,0,0,10" IsVisible="False"/>

                    <ScrollViewer Grid.Row="3">
                        <StackPanel>
                            <ItemsControl Name="ScanResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="core:ScanResult">
                                        <Border Classes="glassRow" CornerRadius="11" Padding="13,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Panel Grid.Column="0" Width="14" Height="14" ClipToBounds="False"
                                                       VerticalAlignment="Center" Margin="0,0,9,0">
                                                    <Ellipse Classes="pingpulse" Width="14" Height="14"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Fill="{Binding Ms, Converter={StaticResource PingBrush}}">
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="4"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="9" Height="9"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Fill="{Binding Ms, Converter={StaticResource PingBrush}}"/>
                                                </Panel>
                                                <c:VText Grid.Column="1" Text="{Binding Ip}" Foreground="White" FontSize="13.5"
                                                           FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" CornerRadius="5" Padding="8,2" Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Ms, Converter={StaticResource PingBrush}, ConverterParameter=bg}"
                                                        BorderBrush="{Binding Ms, Converter={StaticResource PingBrush}, ConverterParameter=border}"
                                                        BorderThickness="1">
                                                    <c:VText Text="{Binding Ms, Converter={StaticResource PingLabel}}"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Foreground="{Binding Ms, Converter={StaticResource PingBrush}}"/>
                                                </Border>
                                                <Button Grid.Column="3" Classes="icon" Tag="{Binding Ip}" Click="CopyScanIp"
                                                        VerticalAlignment="Center" Margin="0,0,4,0" Width="30" Height="30" Padding="0">
                                                    <Path Data="M20 9h-9a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                                                          Stroke="#6E9CF0" StrokeThickness="1.8" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
                                                </Button>
                                                <Button Grid.Column="4" Classes="live primary" Content="{DynamicResource Str.cf_use}" Tag="{Binding Ip}"
                                                        Click="UseCleanIp" Padding="14,5" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Name="ScanHint"
                                       Text="{DynamicResource Str.cf_hint}"
                                       Foreground="#8093B5" FontSize="11.5" Margin="2,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer Name="QualityPanel" IsVisible="False">
                    <StackPanel>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                            <Button Grid.Column="0" Classes="live ghost" Click="CloseQuality" Padding="7" Margin="0,0,10,0">
                                <Path Data="M8 1 L2 7 L8 13" Stroke="#C7D4EC" StrokeThickness="2" StrokeLineCap="Round"
                                      StrokeJoin="Round" Width="10" Height="14" Stretch="Uniform"/>
                            </Button>
                            <c:VText Grid.Column="1" Text="{DynamicResource Str.q_title}" Foreground="White"
                                       FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Name="QRatingCard" Classes="glassCard" CornerRadius="16" Padding="22" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.q_rating}" Foreground="#9FB3D6" FontSize="12.5"
                                           HorizontalAlignment="Center"/>
                                <c:VText Name="QRatingText" Text="—" Foreground="#5B83D6" FontSize="34" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Name="QScoreTrack" Height="7" CornerRadius="3.5" Background="#16233F"
                                        Margin="0,14,0,0" Width="220" HorizontalAlignment="Center">
                                    <Border Name="QScoreBar" Height="7" CornerRadius="3.5" Background="#3D6AD6"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,14">
                            <Border Grid.Column="0" Classes="card" Margin="0,0,7,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M12 3 V16 M6 11 L12 17 L18 11" Stroke="{StaticResource DownGrad}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16"
                                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <c:VText Text="{DynamicResource Str.q_download}" Foreground="{StaticResource DownGrad}"
                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                        <TextBlock Name="QDownVal" Text="—" Foreground="{StaticResource DownGrad}" FontSize="25" FontWeight="Bold"/>
                                        <c:VText Text="Mbps" Foreground="#8093B5" FontSize="12"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                                    </StackPanel>
                                    <Border Name="QDownTrack" Height="6" CornerRadius="3" Background="#16233F" Margin="0,10,0,0">
                                        <Border Name="QDownBar" Height="6" CornerRadius="3" Background="{StaticResource DownGrad}"
                                                HorizontalAlignment="Left" Width="0"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M12 21 V8 M6 13 L12 7 L18 13" Stroke="{StaticResource UpGrad}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16"
                                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <c:VText Text="{DynamicResource Str.q_upload}" Foreground="{StaticResource UpGrad}"
                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                        <TextBlock Name="QUpVal" Text="—" Foreground="{StaticResource UpGrad}" FontSize="25" FontWeight="Bold"/>
                                        <c:VText Text="Mbps" Foreground="#8093B5" FontSize="12"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                                    </StackPanel>
                                    <Border Name="QUpTrack" Height="6" CornerRadius="3" Background="#16233F" Margin="0,10,0,0">
                                        <Border Name="QUpBar" Height="6" CornerRadius="3" Background="{StaticResource UpGrad}"
                                                HorizontalAlignment="Left" Width="0"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Path Data="M2 12 H6 L9 5 L15 19 L18 12 H22" Stroke="#E5A63C" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16"
                                          Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <c:VText Text="{DynamicResource Str.q_latency}" Foreground="White" FontSize="13.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str.q_ping_idle}" Foreground="#8FA3C8" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                                            <TextBlock Name="QIdleVal" Text="—" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                            <TextBlock Text="ms" Foreground="#8093B5" FontSize="10.5"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Str.q_ping_down}" Foreground="#8FA3C8" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                                            <TextBlock Name="QDownPingVal" Text="—" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                            <TextBlock Text="ms" Foreground="#8093B5" FontSize="10.5"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Str.q_ping_up}" Foreground="#8FA3C8" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                                            <TextBlock Name="QUpPingVal" Text="—" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                            <TextBlock Text="ms" Foreground="#8093B5" FontSize="10.5"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{DynamicResource Str.q_jitter}" Foreground="#8FA3C8" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                                            <TextBlock Name="QJitterVal" Text="—" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                            <TextBlock Text="ms" Foreground="#8093B5" FontSize="10.5"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Name="QualityButton" Classes="live nohl" Click="RunQuality"
                                    Padding="0" Background="#001A2743" BorderThickness="0"
                                    HorizontalAlignment="Center">
                                <Panel Name="QualityFace" Height="64" MinWidth="300">
                                    <c:GridGlow Name="QualityGlow"/>
                                    <c:VText Name="QualityBtnText" Text="{DynamicResource Str.q_test}"
                                             Foreground="#2ED573" FontSize="19" FontWeight="Bold"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Margin="28,0"/>
                                    <c:WaveLoader Name="QualityWave" IsVisible="False" BarBrush="#2ED573"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <c:VText Name="QualityStatus" Foreground="#8FA3C8" FontSize="12.5"
                                     HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                        <c:VText Name="QLastRun" Foreground="#7C8FB5" FontSize="11.5"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 Margin="0,2,0,0" IsVisible="False"/>
                        <c:VText Text="{DynamicResource Str.q_hint}" Foreground="#8093B5" FontSize="11.5"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 Margin="2,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Name="TorPickPanel" IsVisible="False" RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                        <Button Grid.Column="0" Classes="live" Click="TorPickClose_Click" Padding="6,4" Margin="0,0,10,0">
                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="{StaticResource TextMuted}" StrokeThickness="3"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Button>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.tor_pick_title}" Foreground="White"
                                 FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="2,0,0,10">
                        <Border Grid.Column="0" Classes="glassInset" Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Button Classes="live" Click="TorPickAll_Click" Height="28"
                                        CornerRadius="7" Padding="11,0" FontSize="12"
                                        Content="{DynamicResource Str.tor_pick_all}"/>
                                <Button Classes="live" Click="TorPickNone_Click" Height="28"
                                        CornerRadius="7" Padding="11,0" FontSize="12"
                                        Content="{DynamicResource Str.tor_pick_none}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="8" Background="#0E1A38"
                                BorderBrush="#35548C" BorderThickness="1.2" Height="28" MinWidth="34"
                                Padding="8,0" VerticalAlignment="Center">
                            <TextBlock Name="TorPickCount" Text="0" Foreground="#6E9CF0"
                                       FontSize="12.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2" Name="TorPickScroll">
                        <ItemsControl Name="TorPickList"
                                      PointerMoved="TorPickList_PointerMoved"
                                      PointerReleased="TorPickList_PointerReleased"/>
                    </ScrollViewer>
                </Grid>

                <Grid Name="ExportPanel" IsVisible="False" RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                        <Button Grid.Column="0" Classes="live" Click="ExportCancel_Click" Background="#001A2743"
                                BorderThickness="0" Padding="6,4" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Data="M 8,0 L 0,7 L 8,14" Stroke="#9FB3D6" StrokeThickness="3"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Button>
                        <c:VText Grid.Column="1" Text="{DynamicResource Str.share_as_file}" Foreground="White"
                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <Border Classes="glassChip" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M3.8,8.6 V5.6 A4.2,4.2 0 0 1 12.2,5.6 V8.6 H10.1 V5.6 A2.1,2.1 0 0 0 5.9,5.6 V8.6 Z M3.4,8.4 H12.6 A1.5,1.5 0 0 1 14.1,9.9 V14.2 A1.5,1.5 0 0 1 12.6,15.7 H3.4 A1.5,1.5 0 0 1 1.9,14.2 V9.9 A1.5,1.5 0 0 1 3.4,8.4 Z"
                                          Fill="#6E9CF0" Width="19" Height="19" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                    <c:VText Text="{DynamicResource Str.export_encrypted_note}" Foreground="#A9B8D4"
                                               FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Margin="12,0,0,0" MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Name="ExportCountText" Text="" Foreground="#6E9CF0" FontSize="13.5"
                                       FontWeight="SemiBold" Margin="2,0,0,12" IsVisible="False"/>

                            <TextBlock Text="{DynamicResource Str.export_file_name}" Foreground="#9FB3D6"
                                       FontSize="13" Margin="2,0,0,5"/>
                            <Panel Margin="0,0,0,14" Height="44">
                                <TextBox Name="ExportFileName" Height="44" VerticalContentAlignment="Center"
                                         Padding="12,0,46,0"/>
                                <c:VText Text=".grt" Foreground="#6E9CF0" FontSize="13.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"
                                           IsHitTestVisible="False"/>
                            </Panel>

                            <TextBlock Text="{DynamicResource Str.export_password}" Foreground="#9FB3D6"
                                       FontSize="13" Margin="2,0,0,5"/>
                            <Panel Margin="0,0,0,14" Height="44">
                                <TextBox Name="ExportPwBox" Height="44" VerticalContentAlignment="Center"
                                         PasswordChar="*" Padding="12,0,46,0"/>
                                <Button Name="ExportPwShow" Classes="iconact flat" Click="ExportShowPw_Click"
                                        Width="30" Height="30" CornerRadius="8" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        ToolTip.Tip="{DynamicResource Str.show}">
                                    <Path Name="ExportPwEye"
                                          Data="M1.2 8 C3.2 4.2 5.5 2.6 8 2.6 C10.5 2.6 12.8 4.2 14.8 8 C12.8 11.8 10.5 13.4 8 13.4 C5.5 13.4 3.2 11.8 1.2 8 Z M8 5.7 A2.3 2.3 0 1 0 8 10.3 A2.3 2.3 0 0 0 8 5.7 Z"
                                          Stroke="#9FB3D6" StrokeThickness="1.4" StrokeLineCap="Round"
                                          StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Panel>

                            <CheckBox Name="ExportLock" Content="{DynamicResource Str.export_lock}"
                                      Foreground="#9FB3D6" FontSize="13" Margin="2,0,0,4"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,14,0,0">
                        <Button Grid.Column="0" Classes="live ghost" Content="{DynamicResource Str.cancel}"
                                Click="ExportCancel_Click" Height="44" Margin="0,0,6,0"
                                HorizontalAlignment="Stretch" FontSize="14" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Classes="live primary" Content="{DynamicResource Str.export_continue}"
                                Click="ExportContinue_Click" Height="44" Margin="6,0,0,0"
                                HorizontalAlignment="Stretch" FontSize="14" FontWeight="SemiBold"/>
                    </Grid>
                </Grid>

                <Border Name="LogsPanel" Classes="card" CornerRadius="12" Padding="3" Margin="0"
                        IsVisible="False" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="6,2,4,8">
                            <Button Grid.Column="1" Classes="live" Click="CopyLogs_Click" Height="30"
                                    CornerRadius="9" Padding="12,0" FontSize="12" Margin="0,0,6,0"
                                    Content="{DynamicResource Str.copy}"/>
                            <Button Grid.Column="2" Classes="live" Click="ClearLogs_Click" Height="30"
                                    CornerRadius="9" Padding="12,0" FontSize="12"
                                    Content="{DynamicResource Str.logs_clear}"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#66050D1D" CornerRadius="10" Padding="12,10,4,10">
                            <ScrollViewer Name="LogScroll" VerticalAlignment="Stretch">
                            <Panel>
                                <StackPanel Name="LogPlaceholder" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Spacing="9" Margin="0,26">
                                    <Path Data="M4 3 H16 V17 H4 Z M7 7 H13 M7 10 H13 M7 13 H11" Stroke="#3A4E77"
                                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str.logs_empty}" Classes="muted" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <SelectableTextBlock Name="LogText" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11.5" Foreground="#B9C6E2" TextWrapping="Wrap"
                                           SelectionBrush="#3D6AD6" SelectionForegroundBrush="White"/>
                            </Panel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Name="PrefsPanel" IsVisible="False">
                    <Border Classes="card">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="Transparent"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Path Data="M10 2.2 A7.8 7.8 0 1 0 10 17.8 A7.8 7.8 0 0 0 10 2.2 Z M5 7 h0.01 M14 7 h0.01 M6.5 12.5 h0.01 M13 12 h0.01 M9.5 9.5 h0.01"
                                          Stroke="{StaticResource AccentSoft}" StrokeThickness="1.7" StrokeLineCap="Round"
                                          StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.skin_title}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.skin_hint}" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Border Classes="glassInset" Padding="4" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <RadioButton Classes="seg" Name="SkinDots" GroupName="Skin"
                                                 Content="{DynamicResource Str.skin_dots}" Click="Skin_Set" Tag="dots"/>
                                    <RadioButton Classes="seg" Name="SkinStars" GroupName="Skin"
                                                 Content="{DynamicResource Str.skin_stars}" Click="Skin_Set" Tag="stars"/>
                                    <RadioButton Classes="seg" Name="SkinVein" GroupName="Skin"
                                                 Content="{DynamicResource Str.skin_vein}" Click="Skin_Set" Tag="vein"/>
                                    <RadioButton Classes="seg" Name="SkinPlain" GroupName="Skin"
                                                 Content="{DynamicResource Str.skin_plain}" Click="Skin_Set" Tag="plain"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#1E3157" Margin="0,18,0,16"/>

                            <c:VText Text="{DynamicResource Str.auto_refresh}" Foreground="White" FontSize="14"
                                     FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Classes="glassInset" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <RadioButton Classes="seg" Name="AutoOff" GroupName="AutoRefresh"
                                                 Content="{DynamicResource Str.auto_off}" Click="Auto_Set" Tag="0"/>
                                    <RadioButton Classes="seg" Name="Auto1" GroupName="AutoRefresh" Content="1h" Click="Auto_Set" Tag="1"/>
                                    <RadioButton Classes="seg" Name="Auto6" GroupName="AutoRefresh" Content="6h" Click="Auto_Set" Tag="6"/>
                                    <RadioButton Classes="seg" Name="Auto12" GroupName="AutoRefresh" Content="12h" Click="Auto_Set" Tag="12"/>
                                    <RadioButton Classes="seg" Name="Auto24" GroupName="AutoRefresh" Content="24h" Click="Auto_Set" Tag="24"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#1E3157" Margin="0,18,0,16"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Str.startup_title}" Foreground="White"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.startup_hint}" Classes="muted"
                                             TextWrapping="Wrap"/>
                                </StackPanel>
                                <c:GlassSwitch Grid.Column="1" Name="StartupToggle" VerticalAlignment="Center"
                                               IsCheckedChanged="Startup_Changed"/>
                            </Grid>

                            <Border Height="1" Background="#1E3157" Margin="0,18,0,16"/>

                            <c:VText Text="{DynamicResource Str.exit_button}" Foreground="White" FontSize="14"
                                     FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Classes="glassInset" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <RadioButton Classes="seg" Name="ExitExit" GroupName="ExitAct"
                                                 Content="{DynamicResource Str.act_exit}" Click="ExitAct_Set" Tag="exit"/>
                                    <RadioButton Classes="seg" Name="ExitHide" GroupName="ExitAct"
                                                 Content="{DynamicResource Str.act_hide}" Click="ExitAct_Set" Tag="hide"/>
                                    <RadioButton Classes="seg" Name="ExitMin" GroupName="ExitAct"
                                                 Content="{DynamicResource Str.act_minimize}" Click="ExitAct_Set" Tag="minimize"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#1E3157" Margin="0,18,0,16"/>

                            <c:VText Text="{DynamicResource Str.log_level}" Foreground="White" FontSize="14"
                                     FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Classes="glassInset" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <RadioButton Classes="seg" Name="LogOff" GroupName="LogLevel"
                                                 Content="Off" Click="LogLevelSeg_Click" Tag="none"/>
                                    <RadioButton Classes="seg" Name="LogErr" GroupName="LogLevel"
                                                 Content="Error" Click="LogLevelSeg_Click" Tag="error"/>
                                    <RadioButton Classes="seg" Name="LogWarn" GroupName="LogLevel"
                                                 Content="Warn" Click="LogLevelSeg_Click" Tag="warning"/>
                                    <RadioButton Classes="seg" Name="LogInfo" GroupName="LogLevel"
                                                 Content="Info" Click="LogLevelSeg_Click" Tag="info"/>
                                    <RadioButton Classes="seg" Name="LogDebug" GroupName="LogLevel"
                                                 Content="Debug" Click="LogLevelSeg_Click" Tag="debug"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#1E3157" Margin="0,18,0,16"/>

                            <c:VText Text="{DynamicResource Str.language}" Foreground="White" FontSize="14"
                                     FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ComboBox Name="LangBox" Width="190" Height="34"
                                      HorizontalAlignment="Left" SelectionChanged="PrefLang_Changed">
                                <ComboBoxItem Content="English" Tag="En"/>
                                <ComboBoxItem Content="فارسی" Tag="Fa"/>
                                <ComboBoxItem Content="Русский" Tag="Ru"/>
                                <ComboBoxItem Content="中文" Tag="Zh"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer Name="AboutPanel" IsVisible="False">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Image Name="AboutLogo" Stretch="Uniform" Height="54" Margin="0,14,0,0"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource Str.about_tagline}" Foreground="#C9D4EA"
                                   FontFamily="Edwardian Script ITC, Segoe Script, Gabriola, Lucida Handwriting"
                                   FontSize="34" LineHeight="50" Padding="18,0"
                                   FontWeight="Normal" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,0"/>
                        <Border Name="VersionCard" Background="#0E1A38" BorderBrush="#22345B" BorderThickness="1"
                                CornerRadius="12,12,0,0" Padding="10,8" Margin="0,17,0,0"
                                Width="272" HorizontalAlignment="Center" Loaded="VersionDotsLoaded">
                            <StackPanel Orientation="Horizontal" Spacing="11"
                                        HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                <Panel Width="26" Height="26" VerticalAlignment="Center">
                                    <Ellipse Name="VerHaloL" Width="20" Height="20" Fill="#54658A"
                                             Opacity="0.16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Name="VerGlowL" Width="14" Height="14" Fill="#54658A"
                                             Opacity="0.4"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Name="VerDotL" Width="8" Height="8" Fill="#93A6C9"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                                <c:VText Name="AboutVersion" Foreground="#9FB3D6" FontSize="12.5"
                                         FontFamily="{DynamicResource AppFont}" FlowDirection="LeftToRight"
                                         TextAlignment="Center" VerticalAlignment="Center"/>
                                <Panel Width="26" Height="26" VerticalAlignment="Center">
                                    <Ellipse Name="VerHaloR" Width="20" Height="20" Fill="#54658A"
                                             Opacity="0.16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Name="VerGlowR" Width="14" Height="14" Fill="#54658A"
                                             Opacity="0.4"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Name="VerDotR" Width="8" Height="8" Fill="#93A6C9"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </StackPanel>
                        </Border>
                        <Border Background="#0E1A38" BorderBrush="#22345B" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,12,12" Padding="10,6" Margin="0,0,0,0"
                                Width="272" HorizontalAlignment="Center">
                            <StackPanel>
                                <Button Classes="live ghost" Click="OpenTelegram" Padding="12,13" BorderThickness="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ Border#Bd">
                                            <Setter Property="Background" Value="#001A2743"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Path Grid.Column="0" Data="M21 3 L2 10.5 L9 12.5 L11 20 L14 15 L19 18 Z"
                                              Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                              StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <c:VText Grid.Column="1" Text="{DynamicResource Str.about_support}"
                                                 Foreground="#DCE6F5" FontSize="14" VerticalAlignment="Center"
                                                 Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="#1E3157" Margin="12,2"/>
                                <Button Classes="live ghost" Click="OpenSource" Padding="12,13" BorderThickness="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ Border#Bd">
                                            <Setter Property="Background" Value="#001A2743"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Path Grid.Column="0" Data="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 20 5.4a4.9 4.9 0 0 0-.1-3.6s-1.1-.3-3.6 1.4a12.3 12.3 0 0 0-6.6 0C7.2 1.5 6.1 1.8 6.1 1.8A4.9 4.9 0 0 0 6 5.4a5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V22"
                                              Stroke="#6E9CF0" StrokeThickness="1.6" StrokeLineCap="Round"
                                              StrokeJoin="Round" Width="19" Height="19" Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <c:VText Grid.Column="1" Text="{DynamicResource Str.about_source}"
                                                 Foreground="#DCE6F5" FontSize="14" VerticalAlignment="Center"
                                                 Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                        <c:VText Name="AboutEngine" Foreground="#8FA3C8" FontSize="12.5"
                                 HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <c:VText Name="AboutCopyright" Foreground="#5E6E8C" FontSize="11" FlowDirection="LeftToRight"
                                 HorizontalAlignment="Center" Margin="0,4,0,2"/>
                    </StackPanel>
                </ScrollViewer>

            </Panel>

            <Border Name="DialogOverlay" Grid.RowSpan="3" Background="#C4050D1D" IsVisible="False">
                <Border Name="DlgCard" Width="336" Classes="glassSheet" CornerRadius="16" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Panel Width="34" Height="34" VerticalAlignment="Center">
                                <Ellipse Name="DlgIconBg" Width="34" Height="34" Fill="#1B2F58"/>
                                <Path Name="DlgIcon" Width="18" Height="18" Stretch="None"
                                      StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                            <TextBlock Name="DlgTitle" Foreground="White" FontSize="15.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                        </StackPanel>
                        <c:VText Name="DlgMessage" Foreground="#B9C6E2" FontSize="12.5" TextWrapping="Wrap"
                                   LineHeight="19"/>
                        <TextBox Name="DlgPassword" PasswordChar="*" IsVisible="False" Watermark="Password"/>
                        <Grid Name="DlgButtons" ColumnDefinitions="*,*">
                            <Button Grid.Column="0" Name="DlgCancel" Classes="live ghost" Content="{DynamicResource Str.cancel}"
                                    Click="DlgCancel_Click" HorizontalAlignment="Stretch" Height="40" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Name="DlgOk" Classes="live primary" Content="OK"
                                    Click="DlgOk_Click" HorizontalAlignment="Stretch" Height="40" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <Border Name="ImportPwPanel" Grid.RowSpan="3" Background="#80050D1D" IsVisible="False"
                    PointerPressed="ImportPwDim_Pressed">
                <Border Name="ImportPwCard" Width="290" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Classes="glassSheet" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="11" Background="#16264A" VerticalAlignment="Center">
                                <Path Data="M4,7 V5 A4,4 0 0 1 12,5 V7 M3,7 H13 V14 H3 Z" Stroke="#6E9CF0"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <c:VText Text="{DynamicResource Str.import_password}" Foreground="White" FontSize="15"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBox Name="ImportPwInput" Height="42" VerticalContentAlignment="Center"
                                 Margin="0,0,0,16" PasswordChar="*" Padding="12,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
                            <Button Classes="live ghost" Content="{DynamicResource Str.cancel}" Padding="14,7"
                                    FontSize="12.5" Click="ImportPwCancel_Click"/>
                            <Button Classes="live primary" Content="{DynamicResource Str.import_grt}" Padding="18,7"
                                    FontSize="12.5" Click="ImportPwConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <Panel Name="QuickOverlay" Grid.RowSpan="3" IsVisible="False">
                <Border Name="QuickDim" Background="#8C050D1D" PointerPressed="QuickDim_Click"/>
                <Border Name="QuickSheet" VerticalAlignment="Bottom" Classes="glassSheet"
                        CornerRadius="18,18,0,0" Padding="14,7,14,12" Margin="26,0,26,0">
                    <StackPanel>
                        <Border Width="40" Height="4" CornerRadius="2" Background="#2E4470"
                                HorizontalAlignment="Center" Margin="0,0,0,9"/>
                        <c:VText Text="{DynamicResource Str.quick_title}" Foreground="#C7D4EC" FontSize="13"
                                   FontWeight="SemiBold" Margin="6,0,0,7"/>

                        <Button Classes="live qsrow" Click="QuickMode_Click" Tag="proxy" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Path Grid.Column="0" Data="M3 13 L9 7 L3 1 M11 15 H19" Stroke="#6E9CF0"
                                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.mode_proxy}" Foreground="White"
                                               FontSize="13.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.mode_proxy_d}" Foreground="#8FA3C8" FontSize="11"/>
                                </StackPanel>
                                <Path Grid.Column="2" Name="QSCheckProxy" Data="M2 7 L6 11 L14 2" Stroke="#2FDF8F"
                                      StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="10,0,4,0" IsVisible="False"/>
                            </Grid>
                        </Button>

                        <Button Classes="live qsrow" Click="QuickMode_Click" Tag="system" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Path Grid.Column="0" Data="M2 4 H20 V15 H2 Z M8 19 H14 M11 15 V19" Stroke="#6E9CF0"
                                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.mode_system}" Foreground="White"
                                               FontSize="13.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.mode_system_d}" Foreground="#8FA3C8" FontSize="11"/>
                                </StackPanel>
                                <Path Grid.Column="2" Name="QSCheckSystem" Data="M2 7 L6 11 L14 2" Stroke="#2FDF8F"
                                      StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="10,0,4,0"/>
                            </Grid>
                        </Button>

                        <Button Classes="live qsrow" Click="QuickMode_Click" Tag="tun" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Path Grid.Column="0" Data="M10 20 C10 20 17 16.5 17 11 V4.5 L10 2 L3 4.5 V11 C3 16.5 10 20 10 20 Z"
                                      Stroke="#6E9CF0" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.mode_tun}" Foreground="White"
                                               FontSize="13.5" FontWeight="SemiBold"/>
                                    <c:VText Text="{DynamicResource Str.mode_tun_d}" Foreground="#8FA3C8" FontSize="11"/>
                                </StackPanel>
                                <Path Grid.Column="2" Name="QSCheckTun" Data="M2 7 L6 11 L14 2" Stroke="#2FDF8F"
                                      StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="10,0,4,0" IsVisible="False"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>


        </Grid>
    </Grid>
        </Border>

        <Border Name="MenuOverlay" Width="484" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,24,0,0" CornerRadius="12" ClipToBounds="True"
                Height="{Binding #AppSurface.Bounds.Height}"
                Background="{x:Null}" IsVisible="False" PointerPressed="MenuOverlay_Pressed">
              <Panel Margin="0,42,0,0" ClipToBounds="True">
                <Border Background="#BF040A16"/>
                <Border Name="MenuDrawer" Width="232" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="#0E1A38" BorderBrush="#35548C" BorderThickness="0,0,1,0"
                        CornerRadius="0" Padding="10,14" BoxShadow="5 0 20 0 #80000000">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="MenuList" Spacing="8">
                        <Button Classes="menurow" Name="NavConnect" Click="Nav_Connect">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M2.2,7.4 L8,2.2 L13.8,7.4 M3.7,6.1 V13.6 H12.3 V6.1 M6.5,13.6 V9.5 H9.5 V13.6" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <c:VText Text="{DynamicResource Str.nav_connect}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="menurow" Name="NavUsage" Click="Nav_Usage">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M2,2.5 V13.5 H14 M4.3,10.6 L7.3,7.4 L9.4,9.2 L13.2,4.6" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <c:VText Text="{DynamicResource Str.nav_usage}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="menurow" Name="NavTools" Click="Nav_Tools">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M14.7,3.3 C15.1,4.8 14.7,6.4 13.6,7.5 C12.5,8.6 10.9,9 9.4,8.6 L4,14 L2,12 L7.4,6.6 C7,5.1 7.4,3.5 8.5,2.4 C9.6,1.3 11.2,0.9 12.7,1.3 L10.2,3.8 L12.2,5.8 Z" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <c:VText Text="{DynamicResource Str.nav_tools}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="menurow" Name="NavSettings" Click="Nav_Settings">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M2.5,4.3 H13.5 M8.9,4.3 A1.7,1.7 0 1 0 12.3,4.3 A1.7,1.7 0 1 0 8.9,4.3 M2.5,8 H13.5 M3.8,8 A1.7,1.7 0 1 0 7.2,8 A1.7,1.7 0 1 0 3.8,8 M2.5,11.7 H13.5 M8.3,11.7 A1.7,1.7 0 1 0 11.7,11.7 A1.7,1.7 0 1 0 8.3,11.7" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <c:VText Text="{DynamicResource Str.conn_settings}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="menurow" Name="NavPrefs" Click="Nav_Prefs">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 M8,1.6 V3.2 M8,12.8 V14.4 M1.6,8 H3.2 M12.8,8 H14.4 M3.5,3.5 L4.6,4.6 M11.4,11.4 L12.5,12.5 M12.5,3.5 L11.4,4.6 M4.6,11.4 L3.5,12.5"
                                          Stroke="#C9D6EE" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                                <c:VText Text="{DynamicResource Str.nav_prefs}" FontSize="13" LineHeight="16"
                                         Foreground="#C9D6EE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="menurow" Name="NavAbout" Click="Nav_About">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M8,7.2 V11.3 M8,4.6 V4.9" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <c:VText Text="{DynamicResource Str.nav_about}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="menurow" Name="NavLogs" Click="Nav_Logs">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="M1.5,3.5 H14.5 V12.5 H1.5 Z M4,6.3 L6.6,8.2 L4,10.1 M8.2,10.3 H12"
                                          Stroke="#C9D6EE" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                                <c:VText Text="{DynamicResource Str.nav_logs}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="#2A3C64" Margin="4,2,4,2"/>
                        <Button Classes="menurow" Name="NavUpdate" Click="CheckUpdate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M21 2v6h-6 M3 12a9 9 0 0 1 15-6.7L21 8 M3 22v-6h6 M21 12a9 9 0 0 1-15 6.7L3 16" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <c:VText Text="{DynamicResource Str.check_update}" FontSize="13" LineHeight="16"
                                           Foreground="#E3EBFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto" Margin="12,0,6,0" Height="38">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="13"
                                        VerticalAlignment="Center">
                                <Path Data="M8 1.5 A6.5 6.5 0 1 1 7.99 1.5 M1.6 8 H14.4 M8 1.5 C10 4 10 12 8 14.5 C6 12 6 4 8 1.5" Stroke="#C9D6EE" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"/>

                            </StackPanel>
                            <ComboBox Grid.Column="1" Name="MenuLangBox" Width="150" Height="30"
                                      VerticalAlignment="Center" SelectionChanged="LangBox_Changed">
                                <ComboBoxItem Content="English" Tag="En"/>
                                <ComboBoxItem Content="فارسی" Tag="Fa"/>
                                <ComboBoxItem Content="Русский" Tag="Ru"/>
                                <ComboBoxItem Content="中文" Tag="Zh"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
              </Panel>
            </Border>

        <Border Name="AppStroke" Width="484" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,24,0,0" CornerRadius="12" IsHitTestVisible="False"
                BorderBrush="#0B1730" BorderThickness="1"
                Height="{Binding #AppSurface.Bounds.Height}"/>
        </Panel>
    </Panel>
</Window>
